/* 全局样式 - MUJI无印良品风格优化版 */

/* 优化后的莫兰迪色系 - 增强对比度 */
:root {
  /* 背景色系 */
  --bg-primary: #FAFAF8;        /* 主背景 - 暖白 */
  --bg-secondary: #F5F3F0;      /* 次级背景 - 米灰 */
  --bg-card: #FFFFFF;           /* 卡片背景 - 纯白 */
  
  /* 主色调 - 深原木色 */
  --primary: #8B7355;           /* 深原木色 - 主按钮/强调 */
  --primary-light: #A08060;     /* 浅原木色 - hover状态 */
  --primary-dark: #6B5635;      /* 深原木色 - 按下状态 */
  
  /* 文字色系 */
  --text-primary: #2D2A26;      /* 主文字 - 深炭色 */
  --text-secondary: #5A554D;    /* 次级文字 - 深灰 */
  --text-tertiary: #8A847A;     /* 辅助文字 - 中灰 */
  --text-muted: #B8B2A8;        /* 弱化文字 - 浅灰 */
  
  /* 边框与分割 */
  --border: #E8E4DE;            /* 边框色 */
  --divider: #F0EDE8;           /* 分割线 */
  
  /* 功能色 */
  --success: #7A9E7E;           /* 成功 - 莫兰迪绿 */
  --warning: #D4A574;           /* 警告 - 暖橙 */
  --error: #C47D7D;             /* 错误 - 暗红 */
}

/* 全局重置 */
page {
  background-color: var(--bg-primary);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 14px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

/* 页面容器 */
.page-container {
  min-height: 100vh;
  background-color: var(--bg-primary);
  padding: 16px;
  box-sizing: border-box;
}

/* ===== 卡片组件 ===== */
.card {
  background-color: var(--bg-card);
  border-radius: 12px;
  padding: 20px;
  margin-bottom: 12px;
  box-shadow: 0 2px 8px rgba(45, 42, 38, 0.04);
}

.card-flat {
  background-color: var(--bg-card);
  border-radius: 12px;
  padding: 20px;
  margin-bottom: 12px;
}

/* ===== 文字样式 ===== */
.text-xl {
  font-size: 24px;
  font-weight: 600;
  color: var(--text-primary);
}

.text-lg {
  font-size: 18px;
  font-weight: 500;
  color: var(--text-primary);
}

.text-base {
  font-size: 15px;
  color: var(--text-secondary);
}

.text-sm {
  font-size: 13px;
  color: var(--text-tertiary);
}

.text-xs {
  font-size: 12px;
  color: var(--text-muted);
}

/* ===== 按钮组件 ===== */
.btn-primary {
  width: 100%;
  height: 48px;
  line-height: 48px;
  background-color: var(--primary);
  color: #FFFFFF;
  font-size: 16px;
  font-weight: 500;
  border-radius: 24px;
  border: none;
  text-align: center;
}

.btn-primary:active {
  background-color: var(--primary-dark);
}

.btn-secondary {
  width: 100%;
  height: 48px;
  line-height: 48px;
  background-color: transparent;
  color: var(--primary);
  font-size: 16px;
  font-weight: 500;
  border-radius: 24px;
  border: 1px solid var(--primary);
  text-align: center;
}

.btn-secondary:active {
  background-color: rgba(139, 115, 85, 0.05);
}

.btn-text {
  display: inline-flex;
  align-items: center;
  padding: 8px 16px;
  color: var(--primary);
  font-size: 14px;
  font-weight: 500;
}

/* ===== 列表组件 ===== */
.list {
  background-color: var(--bg-card);
  border-radius: 12px;
  overflow: hidden;
}

.list-item {
  display: flex;
  align-items: center;
  padding: 16px 20px;
  border-bottom: 1px solid var(--divider);
}

.list-item:last-child {
  border-bottom: none;
}

.list-item:active {
  background-color: var(--bg-secondary);
}

.list-icon {
  width: 24px;
  height: 24px;
  margin-right: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.list-content {
  flex: 1;
}

.list-arrow {
  width: 20px;
  height: 20px;
  color: var(--text-muted);
}

/* ===== 图标系统 ===== */
.icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.icon-sm { width: 16px; height: 16px; }
.icon-base { width: 20px; height: 20px; }
.icon-lg { width: 24px; height: 24px; }
.icon-xl { width: 32px; height: 32px; }

/* ===== 空状态 ===== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60px 20px;
}

.empty-icon {
  width: 80px;
  height: 80px;
  margin-bottom: 16px;
  opacity: 0.3;
}

.empty-text {
  font-size: 14px;
  color: var(--text-muted);
}

/* ===== 浮动按钮 ===== */
.fab {
  position: fixed;
  right: 20px;
  bottom: 100px;
  width: 56px;
  height: 56px;
  background-color: var(--primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 12px rgba(139, 115, 85, 0.3);
  z-index: 100;
}

.fab:active {
  transform: scale(0.95);
  background-color: var(--primary-dark);
}

.fab-icon {
  width: 24px;
  height: 24px;
  color: #FFFFFF;
}

/* ===== 进度条 ===== */
.progress-bar {
  height: 4px;
  background-color: var(--divider);
  border-radius: 2px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background-color: var(--primary);
  border-radius: 2px;
  transition: width 0.3s ease;
}

/* ===== 标签 ===== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4px 10px;
  background-color: var(--bg-secondary);
  color: var(--text-secondary);
  font-size: 12px;
  border-radius: 4px;
}

.tag-primary {
  background-color: rgba(139, 115, 85, 0.1);
  color: var(--primary);
}

/* ===== 复选框 ===== */
.checkbox {
  width: 22px;
  height: 22px;
  border: 2px solid var(--border);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12px;
  transition: all 0.2s;
}

.checkbox.checked {
  background-color: var(--primary);
  border-color: var(--primary);
}

.checkbox-icon {
  width: 12px;
  height: 12px;
  color: #FFFFFF;
}

/* ===== 输入框 ===== */
.input {
  width: 100%;
  height: 48px;
  background-color: var(--bg-secondary);
  border: 1px solid transparent;
  border-radius: 8px;
  padding: 0 16px;
  font-size: 15px;
  color: var(--text-primary);
  box-sizing: border-box;
}

.input:focus {
  border-color: var(--primary);
  background-color: var(--bg-card);
}

/* ===== 间距系统 ===== */
.m-0 { margin: 0; }
.m-1 { margin: 4px; }
.m-2 { margin: 8px; }
.m-3 { margin: 12px; }
.m-4 { margin: 16px; }
.m-5 { margin: 20px; }
.m-6 { margin: 24px; }

.p-0 { padding: 0; }
.p-1 { padding: 4px; }
.p-2 { padding: 8px; }
.p-3 { padding: 12px; }
.p-4 { padding: 16px; }
.p-5 { padding: 20px; }
.p-6 { padding: 24px; }

/* ===== 分割线 ===== */
.divider {
  height: 1px;
  background-color: var(--divider);
  margin: 0 20px;
}

/* ===== 隐藏滚动条 ===== */
::-webkit-scrollbar {
  display: none;
}
