<!-- pages/profile/help.wxml -->
<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">帮助与反馈</text>
  </view>

  <!-- FAQ列表 -->
  <view class="faq-section">
    <view class="section-title">常见问题</view>
    
    <view class="faq-list">
      <view 
        wx:for="{{faqs}}" 
        wx:key="id" 
        class="faq-item"
        bindtap="toggleFaq"
        data-id="{{item.id}}"
      >
        <view class="faq-header">
          <text class="faq-question">{{item.question}}</text>
          <text class="faq-arrow">{{item.expanded ? '▼' : '▶'}}</text>
        </view>
        <view wx:if="{{item.expanded}}" class="faq-answer">
          {{item.answer}}
        </view>
      </view>
    </view>
  </view>
</view>