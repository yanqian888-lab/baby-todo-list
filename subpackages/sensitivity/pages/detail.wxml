<!-- 排敏详情页面 -->
<view class="sensitivity-detail">
  <!-- 页面标题 -->
  <view class="page-header">
    <view class="header-left" bindtap="navigateBack">
      <text class="icon-back">←</text>
    </view>
    <view class="header-title">食物详情</view>
    <view class="header-right"></view>
  </view>

  <!-- 食物基本信息 -->
  <view class="food-info" wx:if="{{foodDetail}}">
    <view class="food-header">
      <view class="food-icon">{{foodDetail.name.charAt(0)}}</view>
      <view class="food-main-info">
        <view class="food-name">{{foodDetail.name}}</view>
        <view class="food-type">{{foodDetail.type}}</view>
        <view class="food-category">
          <text class="category-label">适用月龄：</text>
          <text class="category-value">{{foodDetail.minAge}}个月+</text>
        </view>
      </view>
    </view>

    <!-- 食物属性 -->
    <view class="food-properties">
      <view class="property-item">
        <text class="property-label">过敏风险：</text>
        <text class="property-value {{foodDetail.allergyRisk === '高' ? 'risk-high' : foodDetail.allergyRisk === '中' ? 'risk-medium' : 'risk-low'}}">{{foodDetail.allergyRisk}}</text>
      </view>
      <view class="property-item">
        <text class="property-label">推荐指数：</text>
        <text class="property-value">{{foodDetail.recommendIndex}}/5</text>
      </view>
      <view class="property-item">
        <text class="property-label">常见过敏症状：</text>
        <text class="property-value">{{foodDetail.allergySymptoms || '无'}}</text>
      </view>
    </view>

    <!-- 食物介绍 -->
    <view class="food-description">
      <view class="section-title">食物介绍</view>
      <text class="description-content">{{foodDetail.description || '暂无介绍'}}</text>
    </view>

    <!-- 排敏建议 -->
    <view class="sensitivity-suggestion">
      <view class="section-title">排敏建议</view>
      <view class="suggestion-content">
        <view class="suggestion-item">
          <text class="item-label">首次添加量：</text>
          <text class="item-value">{{foodDetail.firstAmount || '少量'}}</text>
        </view>
        <view class="suggestion-item">
          <text class="item-label">观察时间：</text>
          <text class="item-value">{{foodDetail.observeTime || '3-5天'}}</text>
        </view>
        <view class="suggestion-item">
          <text class="item-label">添加方式：</text>
          <text class="item-value">{{foodDetail.addMethod || '泥糊状'}}</text>
        </view>
      </view>
    </view>

    <!-- 注意事项 -->
    <view class="food-notes">
      <view class="section-title">注意事项</view>
      <text class="notes-content">{{foodDetail.notes || '暂无注意事项'}}</text>
    </view>
  </view>

  <!-- 添加排敏记录按钮 -->
  <view class="add-record-btn" wx:if="{{foodDetail}}">
    <button bindtap="addSensitivityRecord" type="primary">添加排敏记录</button>
  </view>

  <!-- 加载状态 -->
  <view class="loading-state" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 错误状态 -->
  <view class="error-state" wx:if="{{error}}">
    <text>{{error}}</text>
    <button bindtap="loadFoodDetail" type="primary">重试</button>
  </view>
</view>