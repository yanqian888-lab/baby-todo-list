/* pages/sensitivity/food-select.wxss - MUJI风格优化版 */

/* 页面容器 */
.container {
  min-height: 100vh;
  background-color: #FAFAF8;
  padding: 16px;
  padding-bottom: calc(100px + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 12px 16px;
  background-color: #FFFFFF;
  border-radius: 12px;
  margin-bottom: 12px;
  box-shadow: 0 2px 6px rgba(45, 42, 38, 0.03);
}

.search-bar input {
  flex: 1;
  height: 40px;
  padding: 0 12px;
  border: 1px solid transparent;
  border-radius: 8px;
  font-size: 14px;
  color: #2D2A26;
  background-color: #F5F3F0;
}

.search-bar input:focus {
  border-color: #8B7355;
  background-color: #FFFFFF;
}

.search-icon {
  margin-left: 8px;
  font-size: 18px;
  color: #8A847A;
}

/* 日期选择器 */
.date-picker-section {
  display: flex;
  align-items: center;
  padding: 12px 16px;
  background-color: #FFFFFF;
  border-radius: 12px;
  margin-bottom: 12px;
  box-shadow: 0 2px 6px rgba(45, 42, 38, 0.03);
}

.date-label {
  font-size: 14px;
  color: #5A554D;
  margin-right: 8px;
}

.date-picker-value {
  font-size: 15px;
  color: #2D2A26;
  font-weight: 500;
  display: flex;
  align-items: center;
}

/* 排敏小TIPS */
.tips-section {
  padding: 16px;
  background-color: #FFFFFF;
  border-radius: 12px;
  margin-bottom: 16px;
  box-shadow: 0 2px 6px rgba(45, 42, 38, 0.03);
}

.tips-title {
  font-size: 15px;
  font-weight: 600;
  color: #2D2A26;
  margin-bottom: 8px;
  display: block;
}

.tips-content {
  font-size: 13px;
  color: #8A847A;
  line-height: 1.6;
  display: block;
  margin-bottom: 4px;
}

/* 食物列表滚动区域 */
.food-scroll {
  width: 100%;
}

/* 分类区域 */
.category-section {
  margin-bottom: 16px;
}

/* 分类标题 - 与首页一致 */
.category-title {
  font-size: 16px;
  font-weight: 600;
  color: #2D2A26;
  padding: 12px 16px;
  background-color: #FFFFFF;
  border-left: 4px solid #8B7355;
  border-radius: 0 8px 8px 0;
  margin-bottom: 10px;
  box-shadow: 0 2px 6px rgba(45, 42, 38, 0.03);
}

/* 食物列表 */
.food-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

/* 食物项 - 与首页一致 */
.food-item {
  padding: 16px;
  background-color: #FFFFFF;
  border-radius: 10px;
  border: 1px solid transparent;
  box-shadow: 0 2px 6px rgba(45, 42, 38, 0.03);
  transition: all 0.2s;
}

.food-item:active {
  background-color: #F5F3F0;
}

/* 选中的食物项 */
.food-item.selected {
  border-color: #8B7355;
  background-color: rgba(139, 115, 85, 0.03);
}

/* 食物头部信息 */
.food-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

/* 食物基本信息 */
.food-basic-info {
  flex: 1;
}

/* 食物名称和分类标签容器 */
.food-name-container {
  display: flex;
  align-items: center;
  margin-bottom: 8px;
}

/* 食物名称 - 与首页一致 */
.food-name {
  font-size: 15px;
  font-weight: 500;
  color: #2D2A26;
  margin-right: 8px;
}

/* 食物分类标签 - 与首页一致 */
.food-category-tag {
  font-size: 12px;
  color: #8A847A;
  background-color: #F0EDE8;
  padding: 2px 8px;
  border-radius: 4px;
}

/* 食物建议月龄 */
.food-recommendation {
  font-size: 12px;
  color: #8A847A;
  margin-bottom: 8px;
  display: block;
}

/* 食物建议做法 */
.food-recipes {
  font-size: 12px;
  color: #8A847A;
  margin-bottom: 8px;
  display: block;
}

/* 食物排敏天数信息 */
.food-allergy-info {
  font-size: 12px;
  color: #8A847A;
  display: inline-block;
}

/* 排敏中状态的高亮样式 */
.food-allergy-info.in-progress {
  color: #8B7355;
  font-weight: 500;
}

/* 已完成排敏状态的样式 */
.food-allergy-info.completed {
  color: #4CAF50;
  font-weight: 500;
}

/* 过敏等级标签 */
.food-allergy-level {
  font-size: 12px;
  margin-left: 8px;
}

.food-allergy-level.level-low {
  color: #7A9E7E;
}

.food-allergy-level.level-medium {
  color: #D4A574;
}

.food-allergy-level.level-high {
  color: #C47D7D;
}

/* 选择按钮 */
.select-btn {
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 12px;
}

/* 选择圆圈 */
.select-circle {
  width: 20px;
  height: 20px;
  border: 2px solid #DDDDDD;
  border-radius: 50%;
  background-color: #FFFFFF;
  transition: all 0.2s;
}

/* 选中的选择圆圈 */
.select-circle.selected {
  background-color: #8B7355;
  border-color: #8B7355;
}

/* 食物偏好设置 */
.food-preferences {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 16px;
  padding-top: 16px;
  border-top: 1px solid #F0EDE8;
}

/* 偏好设置项 */
.preference-item {
  width: 100%;
}

/* 选择器容器 */
.picker {
  width: 100%;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px;
  background-color: #F5F3F0;
  border-radius: 8px;
  box-sizing: border-box;
  font-size: 14px;
  color: #5A554D;
}

/* 选择器值 */
.picker-value {
  font-size: 14px;
  color: #2D2A26;
  font-weight: 500;
}

/* 选择器箭头 */
.picker-arrow {
  font-size: 12px;
  color: #8A847A;
}

/* 空状态 */
.empty-state {
  padding: 60px 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.empty-text {
  font-size: 14px;
  color: #8A847A;
}

/* 底部操作栏 - 固定底部 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16px;
  padding-bottom: calc(16px + env(safe-area-inset-bottom));
  background-color: #FFFFFF;
  box-shadow: 0 -2px 8px rgba(45, 42, 38, 0.06);
  z-index: 100;
}

/* 完成按钮 - 与首页保存按钮一致 */
.bottom-bar .confirm-btn {
  width: 100%;
  height: 48px;
  background-color: #8B7355;
  color: #FFFFFF;
  border: none;
  border-radius: 999px;
  font-size: 16px;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
}

.bottom-bar .confirm-btn::after {
  border: none;
}

.bottom-bar .confirm-btn:active {
  background-color: #6D5A42;
}

/* 自定义食物样式 */
.custom-food-section {
  margin-bottom: 12px;
}

.custom-food-item {
  background-color: #FAFAF8;
  border: 2px dashed #E0DCD5;
  border-radius: 10px;
  padding: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.custom-food-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.custom-food-icon {
  font-size: 24px;
  color: #8A847A;
}

.custom-food-text {
  font-size: 14px;
  color: #8A847A;
}

/* 适配不同屏幕尺寸 */
@media (max-width: 375px) {
  .container {
    padding: 12px;
  }
  
  .food-item {
    padding: 14px;
  }
  
  .food-name {
    font-size: 14px;
  }
}

@media (min-width: 414px) {
  .food-item {
    padding: 18px;
  }
}

/* 自定义食物样式 */
.custom-food-item {
  border: 2px dashed #E0DCD5;
  border-radius: 10px;
  padding: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #FAFAF8;
}

.custom-food-item:active {
  background-color: #F5F3F0;
}

.custom-food-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.custom-food-icon {
  font-size: 24px;
  color: #8A847A;
}

.custom-food-text {
  font-size: 14px;
  color: #8A847A;
}

/* 弹窗样式 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-content {
  background-color: #FFFFFF;
  border-radius: 12px;
  width: 90%;
  max-width: 400px;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px;
  border-bottom: 1px solid #EEEEEE;
}

.modal-title {
  font-size: 18px;
  font-weight: bold;
  color: #2D2A26;
}

.modal-close {
  font-size: 24px;
  color: #8A847A;
  cursor: pointer;
  transition: color 0.2s ease;
}

.modal-close:active {
  color: #2D2A26;
}

.modal-body {
  padding: 20px;
}

/* 表单样式 */
.form-item {
  margin-bottom: 20px;
}

.form-label {
  display: block;
  font-size: 14px;
  color: #2D2A26;
  margin-bottom: 8px;
}

.required {
  color: #D32F2F;
}

.form-input {
  width: 100%;
  height: 40px;
  padding: 0 12px;
  border: 1px solid #EEEEEE;
  border-radius: 8px;
  font-size: 14px;
  color: #2D2A26;
  background-color: #FAFAF8;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #8B7355;
  outline: none;
}

.form-picker {
  width: 100%;
  text-align: center;
}

.modal-footer {
  display: flex;
  justify-content: flex-end;
  gap: 12px;
  padding: 16px 20px;
  border-top: 1px solid #EEEEEE;
}

.cancel-btn, .confirm-btn {
  padding: 12px 24px;
  border-radius: 8px;
  font-size: 14px;
  cursor: pointer;
  transition: all 0.2s ease;
  white-space: nowrap;
  min-width: 80px;
  display: inline-block;
  text-align: center;
}

.cancel-btn {
  background-color: #FFFFFF;
  color: #8A847A;
  border: 1px solid #EEEEEE;
}

.cancel-btn:active {
  background-color: #F5F5F5;
  color: #2D2A26;
}

.confirm-btn {
  background-color: #8B7355;
  color: #FFFFFF;
  border: none;
}

.confirm-btn:active {
  background-color: #6D5A42;
}
