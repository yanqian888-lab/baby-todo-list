/* pages/sensitivity/records.wxss - MUJI风格 */
.container {
  min-height: 100vh;
  background-color: #FAFAF8;
}

/* 页面标题栏 - MUJI风格 */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: #FFFFFF;
  color: #2D2A26;
  border-bottom: 1rpx solid #EEEEEE;
}

.header-left, .header-right {
  width: 60rpx;
}

.back-icon {
  font-size: 36rpx;
  color: #8A847A;
  font-weight: bold;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #2D2A26;
}

/* 主要内容区域 */
.main-content {
  padding: 30rpx;
}

/* 家庭切换 tabs */
.family-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.tab-item {
  padding: 16rpx 32rpx;
  background-color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #6B6560;
  border: 1rpx solid #E8E4DF;
  transition: all 0.2s ease;
}

.tab-item.active {
  background-color: rgba(196, 167, 125, 0.15);
  color: #8B7355;
  border-color: #C4A77D;
  font-weight: 500;
}

/* 筛选条件 */
.filter-section {
  margin-bottom: 30rpx;
}

.filter-tabs {
  display: flex;
  gap: 20rpx;
  background-color: #FFFFFF;
  padding: 10rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(45, 42, 38, 0.04);
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  color: #8A847A;
  border-radius: 8rpx;
  transition: all 0.2s ease;
}

.filter-tab.active {
  background-color: #8B7355;
  color: #FFFFFF;
}

/* 排敏记录列表 */
.records-section {
  background-color: #FFFFFF;
  border-radius: 12rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(45, 42, 38, 0.04);
}

.records-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-item {
  padding: 30rpx;
  border: 2rpx solid #EEEEEE;
  border-radius: 12rpx;
  cursor: pointer;
  transition: all 0.2s ease;
  background-color: #FFFFFF;
}

.record-item:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(45, 42, 38, 0.04);
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.food-info {
  flex: 1;
}

.food-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #2D2A26;
  margin-bottom: 8rpx;
  display: block;
}

.food-category {
  font-size: 24rpx;
  color: #8A847A;
  background-color: #F5F5F5;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.record-status {
  display: flex;
  align-items: center;
}

.status-text {
  font-size: 28rpx;
  font-weight: bold;
}

.status-safe {
  color: #8B7355;
}

.status-allergy {
  color: #D32F2F;
}

.status-unrecorded {
  color: #8A847A;
}

.record-details {
  margin-bottom: 20rpx;
}

.detail-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.detail-label {
  font-size: 24rpx;
  color: #8A847A;
  width: 160rpx;
}

.detail-value {
  font-size: 24rpx;
  color: #2D2A26;
  flex: 1;
}

.record-footer {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  border-top: 2rpx solid #F5F5F5;
  padding-top: 20rpx;
}

.arrow-icon {
  font-size: 24rpx;
  color: #8A847A;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  line-height: 1;
}

.empty-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
  text-align: center;
}

.empty-subtext {
  font-size: 24rpx;
  color: #999;
  text-align: center;
}
