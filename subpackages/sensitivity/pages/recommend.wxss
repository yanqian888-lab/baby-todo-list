/* 排敏推荐页面样式 - MUJI风格 */
.sensitivity-recommend {
  min-height: 100vh;
  background-color: #FAFAF8;
}

/* 页面标题 */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 48px;
  padding: 0 16px;
  background-color: #FFFFFF;
  border-bottom: 1px solid #EEEEEE;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.header-left, .header-right {
  width: 40px;
}

.icon-back {
  font-size: 24px;
  color: #8A847A;
}

.header-title {
  font-size: 18px;
  font-weight: bold;
  color: #2D2A26;
}

/* 宝宝信息卡片 */
.baby-info-card {
  margin: 64px 16px 16px;
  padding: 16px;
  background-color: #FFFFFF;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(45, 42, 38, 0.04);
  display: flex;
  align-items: center;
}

.baby-avatar {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 16px;
}

.baby-avatar image {
  width: 100%;
  height: 100%;
}

.baby-details {
  flex: 1;
}

.baby-name {
  font-size: 18px;
  font-weight: bold;
  color: #2D2A26;
  margin-bottom: 4px;
}

.baby-age {
  font-size: 14px;
  color: #8A847A;
}

.edit-btn {
  padding: 6px 12px;
  border: 1px solid #8B7355;
  border-radius: 16px;
  font-size: 14px;
  color: #8B7355;
  background-color: transparent;
}

.edit-btn:active {
  background-color: rgba(139, 115, 85, 0.05);
}

/* 推荐列表 */
.recommend-list {
  padding: 0 16px 16px;
}

.section-title {
  font-size: 16px;
  font-weight: bold;
  color: #2D2A26;
  margin-bottom: 12px;
  padding-top: 8px;
}

/* 食物网格 */
.food-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
}

/* 食物卡片 */
.food-card {
  padding: 16px;
  background-color: #FFFFFF;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(45, 42, 38, 0.04);
  cursor: pointer;
  transition: transform 0.2s ease;
}

.food-card:active {
  transform: scale(0.98);
}

.food-icon {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background-color: #8B7355;
  color: #FFFFFF;
  font-size: 20px;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12px;
}

.food-name {
  font-size: 16px;
  font-weight: bold;
  color: #2D2A26;
  margin-bottom: 4px;
}

.food-type {
  font-size: 12px;
  color: #8A847A;
  margin-bottom: 8px;
}

.food-reason {
  font-size: 12px;
  color: #8A847A;
}

.reason-label {
  font-weight: bold;
}

.reason-content {
  line-height: 1.4;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 64px 16px;
  text-align: center;
}

.empty-state image {
  width: 120px;
  height: 120px;
  margin-bottom: 16px;
}

.empty-state text {
  font-size: 14px;
  color: #8A847A;
  margin-bottom: 24px;
}

.refresh-btn {
  padding: 8px 24px;
  background-color: #8B7355;
  color: #FFFFFF;
  border: none;
  border-radius: 20px;
  font-size: 14px;
}

/* 加载状态 */
.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 48px 16px;
}

.loading-state text {
  font-size: 14px;
  color: #8A847A;
}
