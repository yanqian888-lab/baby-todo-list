<!-- pages/sensitivity/food-select.wxml -->
<wxs module="fmt">
function joinRecipes(recipes) {
  return recipes && recipes.length ? recipes.join(' · ') : '';
}
module.exports = { joinRecipes: joinRecipes };
</wxs>
<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <input type="text" placeholder="输入辅食名称（或点击快捷标签）" 
           bindinput="onSearchInput" value="{{searchKeyword}}"/>
    <text class="search-icon">🔍</text>
  </view>

  <!-- 日期选择器（仅在排敏tab页进入时显示） -->
  <view class="date-picker-section" wx:if="{{showDatePicker}}">
    <text class="date-label">选择排敏日期：</text>
    <picker mode="date" bindchange="onDateChange" value="{{selectedDate}}" start="{{startDate}}" end="{{endDate}}">
      <view class="date-picker-value">
        {{selectedDate}}
        <text class="picker-arrow">▼</text>
      </view>
    </picker>
  </view>

  <!-- 排敏小TIPS -->
  <view class="tips-section">
    <text class="tips-title">排敏小TIPS：</text>
    <text class="tips-content">• 红疹等症状为轻微过敏，建议三～五个月后再次尝试；</text>
    <text class="tips-content">• 影响呼吸等症状为重度过敏，建议短期内不再尝试并严格避开</text>
  </view>

  <!-- 食物列表 -->
  <view class="food-scroll" id="foodScroll">
    <view wx:for="{{foodCategories}}" wx:key="id" class="category-section">
      <!-- 分类标题 -->
      <view class="category-title">{{item.name}}</view>
      <!-- 食物列表 -->
      <view class="food-list">
        <!-- 如果是自定义食物分类，添加"添加自定义食物"选项 -->
        <view wx:if="{{item.id === 'custom'}}" class="food-item custom-food-item" bindtap="showCustomFoodModal">
          <view class="custom-food-content">
            <text class="custom-food-icon">➕</text>
            <text class="custom-food-text">添加自定义食物</text>
          </view>
        </view>
        
        <!-- 分类下的食物列表 -->
        <view wx:for="{{item.foods}}" wx:for-item="food" wx:key="_id" 
              class="food-item {{selectedFoodMap[food._id] ? 'selected' : ''}}"
              id="food-{{food._id}}">
          <!-- 食物基本信息和选择按钮 -->
          <view class="food-header" bindtap="toggleFoodSelection" data-food-id="{{food._id}}">
            <view class="food-basic-info">
              <view class="food-name-container">
                <text class="food-name">{{food.name}}</text>
                <text class="food-category-tag">{{food.category}}</text>
              </view>
              <view class="food-recommendation">{{item.recommendation}}</view>
              <!-- 建议做法 -->
              <view wx:if="{{food.recipes && food.recipes.length > 0}}" class="food-recipes">建议做法：{{fmt.joinRecipes(food.recipes)}}</view>
              <!-- 排敏天数显示 -->
              <view class="food-allergy-info {{food.sensitivityProgress ? (food.sensitivityProgress.isComplete ? 'completed' : 'in-progress') : ''}}">
                <block wx:if="{{food.sensitivityProgress}}">
                  <block wx:if="{{food.sensitivityProgress.isComplete}}">已完成排敏</block>
                  <block wx:else>排敏中 {{food.sensitivityProgress.currentDays}}/{{food.sensitivityProgress.totalDays}}天</block>
                </block>
                <block wx:else>需排敏{{food.allergyLevel === 3 ? 5 : 3}}天</block>
              </view>
              <!-- 过敏等级标签 -->
              <text class="food-allergy-level {{food.allergyLevel === 1 ? 'level-low' : food.allergyLevel === 2 ? 'level-medium' : 'level-high'}}">{{food.allergyLevel === 1 ? '低敏' : food.allergyLevel === 2 ? '中敏' : '高敏'}}</text>
            </view>
            <view class="select-btn" catchtap="toggleFoodSelection" data-food-id="{{food._id}}">
              <view class="select-circle {{selectedFoodMap[food._id] ? 'selected' : ''}}"></view>
            </view>
          </view>
          
          <!-- 偏好设置，只有当食物被选中时才显示 -->
          <view class="food-preferences" wx:if="{{selectedFoodMap[food._id]}}" catchtap="preventBubble">
            <view class="preference-item">
              <picker bindchange="onLikeChange" data-food-id="{{food._id}}" value="{{(foodPreferences[food._id] && foodPreferences[food._id].likeIndex) || 0}}" range="{{likeOptions}}">
                <view class="picker">
                  <text>是否喜欢</text>
                  <text class="picker-value">{{likeOptions[(foodPreferences[food._id] && foodPreferences[food._id].likeIndex) || 0]}}</text>
                  <text class="picker-arrow">▼</text>
                </view>
              </picker>
            </view>
            <view class="preference-item">
              <picker bindchange="onAllergyChange" data-food-id="{{food._id}}" value="{{(foodPreferences[food._id] && foodPreferences[food._id].allergyIndex) || 0}}" range="{{allergyOptions}}">
                <view class="picker">
                  <text>是否过敏</text>
                  <text class="picker-value">{{allergyOptions[(foodPreferences[food._id] && foodPreferences[food._id].allergyIndex) || 0]}}</text>
                  <text class="picker-arrow">▼</text>
                </view>
              </picker>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{foodCategories.length === 0}}" class="empty-state">
      <text class="empty-text">未找到匹配的食物</text>
    </view>
  </view>

  <!-- 自定义食物弹窗 -->
  <view wx:if="{{showCustomFoodModal}}" class="modal-overlay">
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">添加自定义食物</text>
        <text class="modal-close" bindtap="hideCustomFoodModal">✕</text>
      </view>
      <view class="modal-body">
        <!-- 食物名称 -->
        <view class="form-item">
          <text class="form-label">食物名称 <text class="required">*</text></text>
          <input type="text" placeholder="请输入食物名称" bindinput="onCustomFoodNameInput" value="{{customFood.name}}" class="form-input"/>
        </view>
        <!-- 食物种类 -->
        <view class="form-item">
          <text class="form-label">食物种类 <text class="required">*</text></text>
          <picker bindchange="onCustomFoodCategoryChange" value="{{customFood.categoryIndex}}" range="{{foodCategoryOptions}}">
            <view class="picker form-picker">
              <text class="picker-value">{{foodCategoryOptions[customFood.categoryIndex] || '请选择'}}</text>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
        </view>
        <!-- 排敏天数 -->
        <view class="form-item">
          <text class="form-label">排敏天数 <text class="required">*</text></text>
          <picker bindchange="onCustomFoodDaysChange" value="{{customFood.allergyLevel - 1}}" range="{{['3天', '5天']}}">
            <view class="picker form-picker">
              <text class="picker-value">{{customFood.allergyLevel === 1 ? '3天' : '5天'}}</text>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
        </view>
        <!-- 是否喜欢 -->
        <view class="form-item">
          <text class="form-label">是否喜欢</text>
          <picker bindchange="onCustomFoodLikeChange" value="{{customFood.likeIndex}}" range="{{likeOptions}}">
            <view class="picker form-picker">
              <text class="picker-value">{{likeOptions[customFood.likeIndex]}}</text>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
        </view>
        <!-- 是否过敏 -->
        <view class="form-item">
          <text class="form-label">是否过敏</text>
          <picker bindchange="onCustomFoodAllergyChange" value="{{customFood.allergyIndex}}" range="{{allergyOptions}}">
            <view class="picker form-picker">
              <text class="picker-value">{{allergyOptions[customFood.allergyIndex]}}</text>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
        </view>
      </view>
      <view class="modal-footer">
        <button class="cancel-btn" bindtap="hideCustomFoodModal">取消</button>
        <button class="confirm-btn" bindtap="saveCustomFood">确定</button>
      </view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <button class="confirm-btn" bindtap="confirmSelection" disabled="{{selectedFoodIds.length === 0}}">
      完成（{{selectedFoodIds.length}}）
    </button>
  </view>
</view>