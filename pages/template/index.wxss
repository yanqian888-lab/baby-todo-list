/* pages/template/index.wxss */
.container {
  padding: 10px;
  background-color: #f8f8f8;
  min-height: 100vh;
}

.header {
  padding: 20px 0;
  text-align: center;
}

.title {
  font-size: 20px;
  font-weight: bold;
  color: #333;
}

/* 分类选择器样式 */
.category-tabs {
  margin-bottom: 15px;
}

.category-scroll {
  white-space: nowrap;
  padding-bottom: 10px;
}

.category-tab {
  display: inline-block;
  padding: 8px 16px;
  margin-right: 10px;
  background-color: #fff;
  border-radius: 20px;
  font-size: 14px;
  color: #666;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
}

.category-tab.active {
  background-color: #07c160;
  color: #fff;
}

/* 模板列表样式 */
.template-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.template-item {
  background-color: #fff;
  border-radius: 10px;
  padding: 15px;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
}

.template-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.template-title {
  font-size: 16px;
  font-weight: bold;
  color: #333;
}

.priority-badge {
  background-color: #ff6b6b;
  color: #fff;
  padding: 2px 8px;
  border-radius: 10px;
  font-size: 12px;
}

.template-desc {
  font-size: 14px;
  color: #666;
  margin-bottom: 10px;
  line-height: 1.5;
}

.template-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.category-tag {
  font-size: 12px;
  color: #07c160;
  background-color: #e1f5fe;
  padding: 2px 8px;
  border-radius: 10px;
}

.use-btn {
  min-width: 80px;
}

/* 空状态样式 */
.empty-state {
  text-align: center;
  padding: 40px 0;
  color: #999;
  font-size: 14px;
}

/* 加载状态样式 */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.3);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 999;
}

.loading-content {
  background-color: #fff;
  border-radius: 10px;
  padding: 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
}

.loading-content text {
  font-size: 14px;
  color: #666;
}