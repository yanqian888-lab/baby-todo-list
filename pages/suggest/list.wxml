<!-- pages/suggest/list.wxml -->
<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">事项建议</text>
  </view>

  <!-- 分类选项卡 -->
  <view class="category-tabs">
    <scroll-view scroll-x="true" enable-flex class="tabs-scroll">
      <view 
        class="tab-item {{currentCategory === item.id ? 'active' : ''}}" 
        wx:for="{{categories}}" 
        wx:key="id"
        bindtap="switchCategory"
        data-id="{{item.id}}"
      >
        <text class="tab-text">{{item.name}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 建议列表 -->
  <view class="suggestion-list">
    <block wx:if="{{suggestions.length > 0}}">
      <view 
        class="suggestion-item" 
        wx:for="{{suggestions}}" 
        wx:key="id"
        bindtap="viewDetail"
        data-id="{{item.id}}"
      >
        <!-- 建议卡片头部 -->
        <view class="item-header">
          <view class="item-left">
            <view class="item-icon">{{item.icon}}</view>
            <view class="item-info">
              <view class="item-title">
                {{item.title}}
                <text wx:if="{{item.recommended}}" class="recommended-badge">推荐</text>
              </view>
              <view class="item-desc">{{item.description}}</view>
            </view>
          </view>
          <view class="item-right">
            <view class="frequency-badge">每日</view>
          </view>
        </view>
        
        <!-- 建议卡片底部操作 -->
        <view class="item-footer">
          <button class="add-btn" bindtap="addToTasks" data-item="{{item}}">添加到我的任务</button>
        </view>
      </view>
    </block>
    
    <!-- 空状态 -->
    <view wx:else class="empty-state">
      <view class="empty-icon">📝</view>
      <text class="empty-text">暂无推荐事项</text>
    </view>
    
    <!-- 加载提示 -->
    <view wx:if="{{loading}}" class="loading-state">
      <text class="loading-text">加载中...</text>
    </view>
    
    <!-- 没有更多数据提示 -->
    <view wx:if="{{!hasMore && suggestions.length > 0}}" class="no-more">
      <text class="no-more-text">没有更多了</text>
    </view>
  </view>
</view>