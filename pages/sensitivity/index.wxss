/* pages/sensitivity/index.wxss */
.container {
  min-height: 100vh;
  background-color: #f8f8f8;
}



/* 主要内容区域 */
.main-content {
  padding: 30rpx;
}

/* 没有宝宝信息时的样式 */
.no-baby-info {
  text-align: center;
  padding: 100rpx 0;
}

.info-text {
  display: block;
  margin-bottom: 40rpx;
  font-size: 32rpx;
  color: #666;
}

/* 排敏进度条 */
.progress-section {
  background-color: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.progress-title {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.progress-value {
  font-size: 32rpx;
  color: #07c160;
  font-weight: bold;
}

.progress-bar {
  width: 100%;
  height: 12rpx;
  background-color: #e8e8e8;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background-color: #07c160;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

/* 推荐食物区域 */
.recommended-section {
  background-color: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

/* 区域标题和添加按钮 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

/* 添加按钮样式 */
.add-food-btn {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 60rpx;
  height: 60rpx;
  background-color: #FF7A85;
  color: white;
  border-radius: 50%;
  cursor: pointer;
  transition: all 0.2s ease;
}

.add-food-btn:hover {
  transform: scale(1.05);
}

.add-icon {
  font-size: 40rpx;
  line-height: 60rpx;
}

.food-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.food-item {
  padding: 20rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  cursor: pointer;
  transition: all 0.2s ease;
}

.food-item.selected {
  border-color: #07c160;
  background-color: rgba(7, 193, 96, 0.05);
}

.food-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.food-name {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.food-category {
  font-size: 24rpx;
  color: #999;
  background-color: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.food-details {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.food-level {
  font-size: 24rpx;
}

.level-low {
  color: #07c160;
  font-weight: bold;
}

.level-medium {
  color: #ff976a;
  font-weight: bold;
}

.level-high {
  color: #ff4d4f;
  font-weight: bold;
}

.food-days {
  font-size: 24rpx;
  color: #666;
}

.ongoing-tag {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  background-color: #07c160;
  color: white;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}

.sensitivity-days {
  font-size: 18rpx;
  background-color: rgba(255, 255, 255, 0.3);
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  font-weight: bold;
}

/* 排敏记录区域 */
.record-section {
  background-color: white;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

/* 今日排敏记录样式 */
.today-record {
  background-color: #f0f9ff;
  border: 1rpx solid #e0f2fe;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-top: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0;
}

.record-subtitle {
  font-size: 26rpx;
  color: #333;
  font-weight: bold;
}

.record-content {
  flex: 1;
  padding-right: 30rpx;
}

.modify-btn {
  background-color: #07c160;
  color: white;
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  border: none;
  line-height: 1.5;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
  transition: all 0.2s ease;
  margin-left: 20rpx;
}

.modify-btn:active {
  background-color: #06ae56;
  transform: scale(0.98);
}

.record-item {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
  padding: 5rpx 0;
  border-bottom: 1rpx solid #e8f4fd;
}

.record-item:last-child {
  margin-bottom: 0;
  border-bottom: none;
}

.record-label {
  font-size: 26rpx;
  color: #555;
  width: 140rpx;
  font-weight: bold;
  padding-right: 15rpx;
  text-align: right;
}

.record-value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
  padding-left: 15rpx;
  background-color: white;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  border: 1rpx solid #e0e0e0;
  min-height: 44rpx;
  line-height: 44rpx;
}

/* 今日未排敏提示 */
.no-record {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 24rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}