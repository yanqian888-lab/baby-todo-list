/* pages/sensitivity/index.wxss - MUJI风格优化版 */

.container {
  min-height: 100vh;
  background-color: #FAFAF8;
  padding: 16px;
}

/* 家庭选择器 */
/* 家庭切换 tabs */
.family-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 12px;
}

.tab-item {
  padding: 10px 20px;
  background-color: #FFFFFF;
  border-radius: 999px;
  font-size: 14px;
  color: #6B6560;
  border: 1px solid #E8E4DF;
  transition: all 0.2s ease;
}

.tab-item.active {
  background-color: rgba(196, 167, 125, 0.15);
  color: #8B7355;
  border-color: #C4A77D;
  font-weight: 500;
}

/* ===== 宝宝信息表单 ===== */
.baby-info-form-section {
  background-color: #FFFFFF;
  border-radius: 12px;
  padding: 32px 24px;
  box-shadow: 0 2px 8px rgba(45, 42, 38, 0.04);
}

.form-header {
  text-align: center;
  margin-bottom: 32px;
}

.form-title {
  font-size: 20px;
  font-weight: 600;
  color: #2D2A26;
  margin-bottom: 8px;
  display: block;
}

.form-subtitle {
  font-size: 14px;
  color: #8A847A;
}

.form-content {
  margin-bottom: 32px;
}

.form-item {
  margin-bottom: 20px;
}

.form-label {
  display: block;
  font-size: 14px;
  font-weight: 500;
  color: #5A554D;
  margin-bottom: 8px;
}

.required {
  color: #C47D7D;
}

.form-input {
  width: 100%;
  height: 48px;
  background-color: #F5F3F0;
  border: 1px solid transparent;
  border-radius: 8px;
  padding: 0 16px;
  font-size: 15px;
  color: #2D2A26;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #8B7355;
  background-color: #FFFFFF;
}

.form-picker {
  width: 100%;
  height: 48px;
  background-color: #F5F3F0;
  border: 1px solid transparent;
  border-radius: 8px;
  padding: 0 16px;
  font-size: 15px;
  color: #8A847A;
  line-height: 48px;
  box-sizing: border-box;
}

.form-picker.has-value {
  color: #2D2A26;
  background-color: #FFFFFF;
  border-color: #E8E4DE;
}

/* 性别选择 */
.gender-selector {
  display: flex;
  gap: 12px;
}

.gender-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20px;
  background-color: #F5F3F0;
  border: 2px solid transparent;
  border-radius: 10px;
  transition: all 0.2s;
}

.gender-option.active {
  background-color: #FFFFFF;
  border-color: #8B7355;
}

.gender-icon {
  font-size: 28px;
  margin-bottom: 6px;
}

.gender-text {
  font-size: 14px;
  color: #8A847A;
  font-weight: 500;
}

.gender-option.active .gender-text {
  color: #8B7355;
}

/* 保存按钮 */
.save-btn {
  width: 100%;
  height: 48px;
  line-height: 48px;
  background-color: #8B7355;
  color: #FFFFFF;
  font-size: 16px;
  font-weight: 500;
  border-radius: 24px;
  border: none;
}

.save-btn::after {
  border: none;
}

.save-btn:active {
  background-color: #6B5635;
}

.join-family-hint {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 16px;
  gap: 4px;
}

.hint-text {
  font-size: 13px;
  color: #8A847A;
}

.hint-link {
  font-size: 13px;
  color: #8B7355;
  font-weight: 500;
}

/* 弹窗样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  visibility: hidden;
}

.modal.show {
  visibility: visible;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  left: 16px;
  right: 16px;
  bottom: 16px;
  background-color: #FFFFFF;
  border-radius: 12px;
  padding: 20px;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.modal-title {
  font-size: 17px;
  font-weight: 600;
  color: #2D2A26;
}

.modal-close {
  font-size: 24px;
  color: #8A847A;
  padding: 4px;
}

.modal-body {
  margin-bottom: 20px;
}

.modal-input {
  width: 100%;
  height: 44px;
  padding: 0 12px;
  background-color: #F7F7F7;
  border-radius: 8px;
  font-size: 15px;
  color: #2D2A26;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  gap: 12px;
}

.modal-footer .btn-primary,
.modal-footer .btn-secondary {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 44px;
  padding: 0;
  border-radius: 999px;
  font-size: 15px;
  font-weight: 500;
  text-align: center;
  border: none;
  line-height: 1;
}

.modal-footer .btn-primary {
  background-color: #8B7355;
  color: #FFFFFF;
}

.modal-footer .btn-secondary {
  background-color: #F5F3F0;
  color: #8A847A;
}

/* ===== 排敏进度 ===== */
.progress-section {
  background-color: #FFFFFF;
  border-radius: 12px;
  padding: 20px;
  margin-bottom: 12px;
  box-shadow: 0 2px 6px rgba(45, 42, 38, 0.03);
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.progress-title {
  font-size: 16px;
  font-weight: 600;
  color: #2D2A26;
}

.progress-value {
  font-size: 24px;
  font-weight: 600;
  color: #8B7355;
}

.progress-bar {
  width: 100%;
  height: 6px;
  background-color: #F0EDE8;
  border-radius: 3px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background-color: #8B7355;
  border-radius: 3px;
  transition: width 0.4s ease;
}

/* ===== 推荐食物区域 ===== */
.recommended-section {
  background-color: #FFFFFF;
  border-radius: 12px;
  padding: 20px;
  margin-bottom: 12px;
  box-shadow: 0 2px 6px rgba(45, 42, 38, 0.03);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.section-title {
  font-size: 16px;
  font-weight: 600;
  color: #2D2A26;
}

.add-food-btn {
  width: 32px;
  height: 32px;
  background-color: #8B7355;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-food-btn:active {
  background-color: #6B5635;
}

.add-icon {
  color: #FFFFFF;
  font-size: 18px;
  font-weight: 300;
}

.food-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.food-item {
  padding: 16px;
  background-color: #FAFAF8;
  border-radius: 10px;
  border: 1px solid transparent;
  transition: all 0.2s;
}

.food-item:active {
  background-color: #F5F3F0;
}

.food-item.selected {
  border-color: #8B7355;
  background-color: rgba(139, 115, 85, 0.03);
}

.food-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.food-name {
  font-size: 15px;
  font-weight: 500;
  color: #2D2A26;
}

.food-category {
  font-size: 12px;
  color: #8A847A;
  background-color: #F0EDE8;
  padding: 2px 8px;
  border-radius: 4px;
}

.food-details {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.food-level {
  font-size: 13px;
  font-weight: 500;
}

.level-low {
  color: #7A9E7E;
}

.level-medium {
  color: #D4A574;
}

.level-high {
  color: #C47D7D;
}

.food-days {
  font-size: 12px;
  color: #8A847A;
}

.food-recipes {
  font-size: 12px;
  color: #8A847A;
  margin-top: 6px;
  line-height: 1.6;
}

/* ===== 推荐食物记录弹窗 ===== */
.food-record-info {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 16px;
}

.food-record-name {
  font-size: 16px;
  font-weight: 600;
  color: #2D2A26;
}

.food-record-category {
  font-size: 12px;
  color: #8A847A;
  background-color: #F0EDE8;
  padding: 2px 8px;
  border-radius: 4px;
}

.food-record-level {
  font-size: 13px;
  font-weight: 500;
}

.food-record-section {
  margin-bottom: 16px;
}

.food-record-label {
  font-size: 13px;
  color: #8A847A;
  margin-bottom: 8px;
}

.food-record-recipe {
  font-size: 13px;
  color: #2D2A26;
  line-height: 1.8;
}

.food-record-options {
  display: flex;
  gap: 10px;
}

.food-record-option {
  flex: 1;
  text-align: center;
  font-size: 14px;
  color: #2D2A26;
  background-color: #F5F3F0;
  border: 1px solid transparent;
  border-radius: 8px;
  padding: 8px 0;
}

.food-record-option.active {
  color: #8B7355;
  border-color: #8B7355;
  background-color: rgba(139, 115, 85, 0.08);
}

.ongoing-tag {
  display: inline-block;
  font-size: 11px;
  color: #8B7355;
  background-color: rgba(139, 115, 85, 0.1);
  padding: 3px 8px;
  border-radius: 4px;
  margin-top: 8px;
}

/* ===== 今日排敏记录 ===== */
.record-section {
  background-color: #FFFFFF;
  border-radius: 12px;
  padding: 20px;
  box-shadow: 0 2px 6px rgba(45, 42, 38, 0.03);
}

.today-record {
  background-color: #FAFAF8;
  border-radius: 10px;
  padding: 16px;
  margin-top: 12px;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.record-content {
  flex: 1;
}

.record-item {
  display: flex;
  margin-bottom: 10px;
}

.record-item:last-child {
  margin-bottom: 0;
}

.record-label {
  font-size: 13px;
  color: #8A847A;
  width: 70px;
  flex-shrink: 0;
}

.record-value {
  font-size: 14px;
  color: #2D2A26;
  font-weight: 500;
}

.record-actions {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.modify-btn {
  width: 60px;
  height: 32px;
  line-height: 30px;
  background-color: transparent;
  color: #8B7355;
  font-size: 13px;
  border: 1px solid #8B7355;
  border-radius: 16px;
  padding: 0;
}

.modify-btn::after {
  border: none;
}

.modify-btn:active {
  background-color: rgba(139, 115, 85, 0.05);
}

.delete-btn {
  width: 60px;
  height: 32px;
  line-height: 30px;
  background-color: transparent;
  color: #999;
  font-size: 13px;
  border: 1px solid #ddd;
  border-radius: 16px;
  padding: 0;
}

.delete-btn::after {
  border: none;
}

.delete-btn:active {
  background-color: rgba(0, 0, 0, 0.05);
}

.no-record {
  text-align: center;
  padding: 40px 20px;
  color: #B8B2A8;
  font-size: 14px;
}

/* 底部上拉弹窗（记录排敏） */
.modal-bottom .modal-mask {
  opacity: 0;
  transition: opacity 0.28s ease;
}

.modal-bottom.show .modal-mask {
  opacity: 1;
}

.modal-bottom .modal-content {
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 16px 16px 0 0;
  padding: 20px 20px calc(20px + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.28s ease;
}

.modal-bottom.show .modal-content {
  transform: translateY(0);
}
