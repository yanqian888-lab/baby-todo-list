/* pages/sensitivity/records.wxss */
.container {
  min-height: 100vh;
  background-color: #f8f8f8;
}

/* 页面标题栏 */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: #FF7A85;
  color: white;
}

.header-left, .header-right {
  width: 60rpx;
}

.back-icon {
  font-size: 36rpx;
  color: white;
  font-weight: bold;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
}

/* 主要内容区域 */
.main-content {
  padding: 30rpx;
}

/* 筛选条件 */
.filter-section {
  margin-bottom: 30rpx;
}

.filter-tabs {
  display: flex;
  gap: 20rpx;
  background-color: white;
  padding: 10rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  color: #999;
  border-radius: 12rpx;
  transition: all 0.2s ease;
}

.filter-tab.active {
  background-color: #FF7A85;
  color: white;
}

/* 排敏记录列表 */
.records-section {
  background-color: white;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.records-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-item {
  padding: 30rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 16rpx;
  cursor: pointer;
  transition: all 0.2s ease;
}

.record-item:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.food-info {
  flex: 1;
}

.food-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
  display: block;
}

.food-category {
  font-size: 24rpx;
  color: #999;
  background-color: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.record-status {
  display: flex;
  align-items: center;
}

.status-text {
  font-size: 28rpx;
  font-weight: bold;
}

.status-safe {
  color: #07c160;
}

.status-allergy {
  color: #ff4d4f;
}

.record-details {
  margin-bottom: 20rpx;
}

.detail-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.detail-label {
  font-size: 24rpx;
  color: #999;
  width: 160rpx;
}

.detail-value {
  font-size: 24rpx;
  color: #333;
  flex: 1;
}

.record-footer {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  border-top: 2rpx solid #f5f5f5;
  padding-top: 20rpx;
}

.arrow-icon {
  font-size: 24rpx;
  color: #ccc;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  display: block;
}

.empty-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
  display: block;
}

.empty-subtext {
  font-size: 24rpx;
  color: #999;
  display: block;
}