/* 添加排敏记录页面样式 - MUJI风格 */
.add-record {
  min-height: 100vh;
  background-color: #FAFAF8;
}

/* 页面标题 */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 48px;
  padding: 0 16px;
  background-color: #FFFFFF;
  border-bottom: 1px solid #EEEEEE;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.header-left, .header-right {
  width: 40px;
}

.icon-back {
  font-size: 24px;
  color: #8A847A;
}

.header-title {
  font-size: 18px;
  font-weight: bold;
  color: #2D2A26;
}

/* 表单容器 */
.form-container {
  padding: 64px 16px 16px;
}

/* 表单章节 */
.form-section {
  background-color: #FFFFFF;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 16px;
  box-shadow: 0 2px 8px rgba(45, 42, 38, 0.04);
}

.section-title {
  font-size: 16px;
  font-weight: bold;
  color: #2D2A26;
  margin-bottom: 16px;
  padding-bottom: 8px;
  border-bottom: 1px solid #EEEEEE;
}

/* 食物信息项 */
.food-info-item {
  display: flex;
  align-items: center;
  margin-bottom: 8px;
}

.food-info-item:last-child {
  margin-bottom: 0;
}

.label {
  width: 80px;
  font-weight: bold;
  color: #8A847A;
  font-size: 14px;
}

.value {
  flex: 1;
  color: #2D2A26;
  font-size: 14px;
}

/* 日期选择器 */
.date-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 0;
  border: 1px solid #EEEEEE;
  border-radius: 8px;
  background-color: #FAFAF8;
  cursor: pointer;
}

.date-picker .label {
  width: auto;
  margin-right: 8px;
}

.date-picker .value {
  flex: 1;
  color: #8B7355;
}

.icon-right {
  color: #8A847A;
  font-size: 16px;
  margin-right: 8px;
}

/* 状态选项 */
.status-options {
  display: flex;
  justify-content: space-between;
  padding: 8px 0;
}

.status-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16px 8px;
  border: 1px solid #EEEEEE;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.2s ease;
  margin: 0 4px;
  background-color: #FFFFFF;
}

.status-option:first-child {
  margin-left: 0;
}

.status-option:last-child {
  margin-right: 0;
}

.status-option.active {
  border-color: #8B7355;
  background-color: #F5F0E8;
}

.status-icon {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  font-weight: bold;
  margin-bottom: 8px;
}

.safe-icon {
  background-color: #8B7355;
  color: #FFFFFF;
}

.allergic-icon {
  background-color: #D32F2F;
  color: #FFFFFF;
}

.unknown-icon {
  background-color: #8A847A;
  color: #FFFFFF;
}

.status-text {
  font-size: 14px;
  color: #2D2A26;
}

/* 文本输入框 */
.symptoms-input, .remark-input {
  width: 100%;
  min-height: 100px;
  padding: 12px;
  border: 1px solid #EEEEEE;
  border-radius: 8px;
  font-size: 14px;
  color: #2D2A26;
  background-color: #FAFAF8;
  resize: none;
  box-sizing: border-box;
}

.symptoms-input::placeholder, .remark-input::placeholder {
  color: #8A847A;
}

/* 提交按钮 */
.submit-section {
  padding: 16px 0;
}

.submit-btn {
  width: 100%;
  height: 48px;
  background-color: #8B7355;
  color: #FFFFFF;
  border: none;
  border-radius: 24px;
  font-size: 16px;
  font-weight: bold;
}

.submit-btn[disabled] {
  background-color: #EEEEEE;
  color: #8A847A;
}
