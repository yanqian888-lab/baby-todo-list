<!-- pages/sensitivity/index.wxml - MUJI风格优化版 -->
<wxs module="fmt">
function joinRecipes(recipes) {
  return recipes && recipes.length ? recipes.join(' · ') : '';
}
module.exports = { joinRecipes: joinRecipes };
</wxs>
<view class="container">

  <!-- 宝宝信息填写表单 -->
  <view wx:if="{{showBabyInfoForm}}" class="baby-info-form-section">
    <view class="form-header">
      <text class="form-title">完善宝宝信息</text>
      <text class="form-subtitle">首次使用排敏功能，请填写宝宝的基本信息</text>
    </view>
    
    <view class="form-content">
      <view class="form-item">
        <text class="form-label">宝宝昵称 <text class="required">*</text></text>
        <input 
          class="form-input" 
          type="text" 
          placeholder="请输入宝宝昵称" 
          value="{{babyInfoForm.nickname}}"
          bindinput="onNicknameInput"
        />
      </view>
      
      <view class="form-item">
        <text class="form-label">出生日期 <text class="required">*</text></text>
        <picker 
          mode="date" 
          start="{{startDate}}" 
          end="{{currentDate}}"
          value="{{babyInfoForm.birthday}}"
          bindchange="onBirthdayChange"
        >
          <view class="form-picker {{babyInfoForm.birthday ? 'has-value' : ''}}">
            {{babyInfoForm.birthday || '请选择出生日期'}}
          </view>
        </picker>
      </view>
      
      <view class="form-item">
        <text class="form-label">性别</text>
        <view class="gender-selector">
          <view class="gender-option {{babyInfoForm.gender === 'boy' ? 'active' : ''}}"
                bindtap="onGenderChange" data-gender="boy">
            <text class="gender-icon">👦</text>
            <text class="gender-text">男宝</text>
          </view>
          <view class="gender-option {{babyInfoForm.gender === 'girl' ? 'active' : ''}}"
                bindtap="onGenderChange" data-gender="girl">
            <text class="gender-icon">👧</text>
            <text class="gender-text">女宝</text>
          </view>
        </view>
      </view>
    </view>
    
    <button class="save-btn" bindtap="saveBabyInfo">保存并开始使用</button>
    <view class="join-family-hint">
      <text class="hint-text">已有宝宝家庭？</text>
      <text class="hint-link" bindtap="showJoinFamilyModal">点击加入</text>
    </view>

    <!-- 加入家庭弹窗 -->
    <view class="modal {{showJoinFamilyModal ? 'show' : ''}}">
      <view class="modal-mask" bindtap="hideJoinFamilyModal"></view>
      <view class="modal-content">
        <view class="modal-header">
          <text class="modal-title">加入家庭</text>
          <text class="modal-close" bindtap="hideJoinFamilyModal">×</text>
        </view>
        <view class="modal-body">
          <input class="modal-input" type="text" placeholder="请输入邀请码" value="{{inviteCode}}" bindinput="onInviteCodeChange" />
        </view>
        <view class="modal-footer">
          <button class="btn-secondary" bindtap="hideJoinFamilyModal">取消</button>
          <button class="btn-primary" bindtap="joinFamilyByInviteCode">确认加入</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 排敏主内容 -->
  <block wx:elif="{{babyInfo && babyInfo.nickname}}">
    <!-- 家庭切换 tabs -->
    <view class="family-tabs" wx:if="{{families.length > 0}}">
      <view
        wx:for="{{families}}"
        wx:key="_id"
        class="tab-item {{currentFamilyId === item._id ? 'active' : ''}}"
        bindtap="switchFamilyTab"
        data-tab-id="{{item._id}}"
      >{{item.name || item.displayName}}</view>
    </view>

    <!-- 排敏进度 -->
    <view class="progress-section">
      <view class="progress-header">
        <text class="progress-title">排敏进度</text>
        <text class="progress-value">{{sensitivityProgress}}%</text>
      </view>
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{sensitivityProgress}}%"></view>
      </view>
    </view>

    <!-- 推荐食物 -->
    <view class="recommended-section">
      <view class="section-header">
        <text class="section-title">{{recommendationTitle}}</text>
        <view class="add-food-btn" bindtap="navigateToFoodSelect">
          <text class="add-icon">+</text>
        </view>
      </view>
      
      <view class="food-list">
        <view class="food-item {{selectedFood && selectedFood._id === item._id ? 'selected' : ''}}"
              wx:for="{{recommendedFoods}}" 
              wx:key="_id"
              bindtap="selectFood" data-food-id="{{item._id}}">
          <view class="food-info">
            <text class="food-name">{{item.name}}</text>
            <text class="food-category">{{item.category}}</text>
          </view>
          <view class="food-details">
            <text class="food-level">
              <text wx:if="{{item.allergyLevel === 1}}" class="level-low">低敏</text>
              <text wx:elif="{{item.allergyLevel === 2}}" class="level-medium">中敏</text>
              <text wx:else class="level-high">高敏</text>
            </text>
            <text class="food-days">
              <text wx:if="{{item.sensitivityDays}}">已排{{item.sensitivityDays}}/{{item.allergyLevel === 3 ? 5 : 3}}天</text>
              <text wx:else>需排敏{{item.allergyLevel === 3 ? 5 : 3}}天</text>
            </text>
          </view>
          <view wx:if="{{item.recipes && item.recipes.length > 0}}" class="food-recipes">建议做法：{{fmt.joinRecipes(item.recipes)}}</view>
          <view wx:if="{{item.sensitivityDays}}" class="ongoing-tag">排敏中</view>
        </view>
      </view>
    </view>

    <!-- 今日排敏记录 -->
    <view class="record-section">
      <view class="section-title">今日排敏记录</view>
      
      <view wx:if="{{todaySensitivityRecord}}" class="today-record">
        <view class="record-header">
          <view class="record-content">
            <view class="record-item">
              <text class="record-label">排敏食物</text>
              <text class="record-value">{{todaySensitivityRecord.foodName}}</text>
            </view>
            <view class="record-item">
              <text class="record-label">喜欢程度</text>
              <text class="record-value">{{likeStatusText}}</text>
            </view>
            <view class="record-item">
              <text class="record-label">过敏情况</text>
              <text class="record-value">{{allergyStatusText}}</text>
            </view>
          </view>
          <view class="record-actions">
            <button class="modify-btn" bindtap="modifyTodayRecord">修改</button>
            <button class="delete-btn" bindtap="deleteTodayRecord">删除</button>
          </view>
        </view>
      </view>
      
      <view wx:else class="no-record">
        <text>今日尚未添加排敏记录</text>
      </view>
    </view>

    <!-- 推荐食物记录弹窗 -->
    <view class="modal {{showFoodRecordModal ? 'show' : ''}}">
      <view class="modal-mask" bindtap="hideFoodRecordModal"></view>
      <view class="modal-content">
        <view class="modal-header">
          <text class="modal-title">记录排敏</text>
          <text class="modal-close" bindtap="hideFoodRecordModal">×</text>
        </view>
        <view class="modal-body">
          <view class="food-record-info">
            <text class="food-record-name">{{recordFood.name}}</text>
            <text class="food-record-category">{{recordFood.category}}</text>
            <text class="food-record-level">
              <text wx:if="{{recordFood.allergyLevel === 1}}" class="level-low">低敏</text>
              <text wx:elif="{{recordFood.allergyLevel === 2}}" class="level-medium">中敏</text>
              <text wx:else class="level-high">高敏</text>
            </text>
          </view>

          <view wx:if="{{recordFood.recipes && recordFood.recipes.length > 0}}" class="food-record-section">
            <view class="food-record-label">建议做法</view>
            <view class="food-record-recipe" wx:for="{{recordFood.recipes}}" wx:key="index">· {{item}}</view>
          </view>

          <view class="food-record-section">
            <view class="food-record-label">是否喜欢</view>
            <view class="food-record-options">
              <view class="food-record-option {{recordLikeStatus === 0 ? 'active' : ''}}" data-value="{{0}}" bindtap="onRecordLikeChange">不喜欢</view>
              <view class="food-record-option {{recordLikeStatus === 1 ? 'active' : ''}}" data-value="{{1}}" bindtap="onRecordLikeChange">一般</view>
              <view class="food-record-option {{recordLikeStatus === 2 ? 'active' : ''}}" data-value="{{2}}" bindtap="onRecordLikeChange">喜欢</view>
            </view>
          </view>

          <view class="food-record-section">
            <view class="food-record-label">是否过敏</view>
            <view class="food-record-options">
              <view class="food-record-option {{recordAllergyStatus === 0 ? 'active' : ''}}" data-value="{{0}}" bindtap="onRecordAllergyChange">不过敏</view>
              <view class="food-record-option {{recordAllergyStatus === 1 ? 'active' : ''}}" data-value="{{1}}" bindtap="onRecordAllergyChange">轻微过敏</view>
              <view class="food-record-option {{recordAllergyStatus === 2 ? 'active' : ''}}" data-value="{{2}}" bindtap="onRecordAllergyChange">重度过敏</view>
            </view>
          </view>
        </view>
        <view class="modal-footer">
          <button class="btn-secondary" bindtap="hideFoodRecordModal">取消</button>
          <button class="btn-primary" disabled="{{recordSaving}}" bindtap="saveFoodRecord">{{recordSaving ? '保存中' : '保存'}}</button>
        </view>
      </view>
    </view>
  </block>
</view>
