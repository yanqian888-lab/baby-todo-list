/* pages/profile/baby-info.wxss - MUJI风格 */

.container {
  min-height: 100vh;
  background-color: #F5F3F0;
  padding: 32rpx;
}

/* 家庭切换 tabs */
.family-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.tab-item {
  padding: 16rpx 32rpx;
  background-color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #6B6560;
  border: 1rpx solid #E8E4DF;
  transition: all 0.2s ease;
}

.tab-item.active {
  background-color: rgba(196, 167, 125, 0.15);
  color: #8B7355;
  border-color: #C4A77D;
  font-weight: 500;
}

/* 只读区域 */
.readonly-section {
  background-color: #FAF9F7;
  border-radius: 20rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 2rpx 12rpx rgba(107, 101, 96, 0.04);
}

.readonly-header {
  text-align: center;
  margin-bottom: 48rpx;
}

.readonly-title {
  font-size: 36rpx;
  color: #4A4540;
  font-weight: 400;
  letter-spacing: 2rpx;
  display: block;
  margin-bottom: 12rpx;
}

.readonly-subtitle {
  font-size: 26rpx;
  color: #B5ADA5;
  font-weight: 400;
}

.readonly-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #F0EDE8;
}

.readonly-item:last-child {
  border-bottom: none;
}

.readonly-label {
  font-size: 28rpx;
  color: #6B6560;
}

.readonly-value {
  font-size: 30rpx;
  color: #4A4540;
  font-weight: 500;
}

.readonly-tip {
  margin-top: 32rpx;
  padding: 20rpx;
  background-color: #F5F3F0;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #B5ADA5;
  text-align: center;
}

.form-section {
  background-color: #FAF9F7;
  border-radius: 20rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 2rpx 12rpx rgba(107, 101, 96, 0.04);
}

.form-header {
  text-align: center;
  margin-bottom: 48rpx;
}

.form-title {
  font-size: 36rpx;
  color: #4A4540;
  font-weight: 400;
  letter-spacing: 2rpx;
  display: block;
  margin-bottom: 12rpx;
}

.form-subtitle {
  font-size: 26rpx;
  color: #B5ADA5;
  font-weight: 400;
}

.form-content {
  margin-bottom: 48rpx;
}

.form-item {
  margin-bottom: 40rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #6B6560;
  margin-bottom: 16rpx;
  font-weight: 400;
  letter-spacing: 1rpx;
}

.form-input {
  width: 100%;
  height: 96rpx;
  background-color: #FFFFFF;
  border: 1rpx solid #E8E4DF;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #4A4540;
  box-sizing: border-box;
  transition: all 0.3s ease;
}

.form-input:focus {
  border-color: #C4A77D;
}

.form-picker {
  width: 100%;
  height: 96rpx;
  background-color: #FFFFFF;
  border: 1rpx solid #E8E4DF;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #B5ADA5;
  line-height: 96rpx;
  box-sizing: border-box;
}

.form-picker.has-value {
  color: #4A4540;
}

.gender-selector {
  display: flex;
  gap: 24rpx;
}

.gender-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 32rpx;
  background-color: #FFFFFF;
  border: 1rpx solid #E8E4DF;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.gender-option.active {
  background-color: rgba(196, 167, 125, 0.1);
  border-color: #C4A77D;
}

.gender-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.gender-text {
  font-size: 28rpx;
  color: #B5ADA5;
}

.gender-option.active .gender-text {
  color: #C4A77D;
  font-weight: 500;
}

.safe-foods-section {
  margin-top: 8rpx;
}

.safe-foods-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.safe-foods-hint {
  font-size: 24rpx;
  color: #B5ADA5;
}

/* 添加食物按钮 */
.add-food-btn {
  width: 100%;
  height: 80rpx;
  background-color: #F5F3F0;
  border: 2rpx dashed #D4CFC7;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.add-food-btn:active {
  background-color: #EBE8E4;
}

.add-icon {
  font-size: 40rpx;
  color: #B5ADA5;
  font-weight: 300;
}

/* 已选食物列表 */
.selected-foods-list {
  background-color: #FFFFFF;
  border-radius: 12rpx;
  padding: 0 24rpx;
}

.food-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0EDE8;
}

.food-item:last-child {
  border-bottom: none;
}

.food-name {
  font-size: 30rpx;
  color: #4A4540;
}

.food-tags {
  display: flex;
  gap: 16rpx;
}

.food-tag {
  font-size: 26rpx;
  color: #8A847A;
  min-width: 100rpx;
  text-align: center;
}

.food-tag.liked {
  color: #5A8C5A;
}

.food-tag.disliked {
  color: #C4A77D;
}

.food-tag.neutral {
  color: #8A847A;
}

.food-tag.allergic {
  color: #C45C5C;
}

.food-tag.severe {
  color: #C45C5C;
  font-weight: 500;
}

.food-tag.safe {
  color: #5A8C5A;
}

.save-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background-color: #C4A77D;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 400;
  border-radius: 48rpx;
  border: none;
  letter-spacing: 2rpx;
  transition: all 0.3s ease;
}

.save-btn::after {
  border: none;
}

.save-btn[disabled] {
  background-color: #D4CFC7;
}

.save-btn:not([disabled]):active {
  background-color: #D4BC9A;
  transform: scale(0.98);
}
