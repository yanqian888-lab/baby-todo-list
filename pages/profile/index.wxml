<!-- pages/profile/index.wxml - MUJI风格优化版 -->
<view class="container">
  <!-- 用户信息 -->
  <view class="user-card">
    <view class="user-info">
      <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
        <view class="avatar-wrap">
          <image wx:if="{{userInfo.avatarUrl}}" class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"/>
          <image wx:else class="avatar" src="/images/touxiang_moren.png" mode="aspectFill"/>
        </view>
      </button>
      <view class="info">
        <input class="nickname nickname-input"
               type="nickname"
               placeholder="点击填写昵称"
               value="{{userInfo.nickName}}"
               bindblur="onNicknameChange"
               bindconfirm="onNicknameChange"/>
        <view wx:if="{{userInfo.babyName}}" class="baby-info">
          <text class="baby-icon">👶</text>
          <text class="baby-name">{{userInfo.babyName}}</text>
          <text wx:if="{{userInfo.babyAge}}" class="baby-age">{{userInfo.babyAge}}</text>
        </view>
      </view>
      <button wx:if="{{!hasUserInfo}}" class="login-btn" catchtap="navigateToLogin">登录</button>
    </view>
  </view>

  <!-- 统计 -->
  <view class="stats-card">
    <view class="stats-item" bindtap="goToTaskList" data-type="all">
      <text class="stats-value">{{stats.totalTasks}}</text>
      <text class="stats-label">总任务</text>
    </view>
    <view class="stats-item" bindtap="goToTaskList" data-type="completed">
      <text class="stats-value">{{stats.completedTasks}}</text>
      <text class="stats-label">已完成</text>
    </view>
  </view>

  <!-- 排敏进度 -->
  <view class="progress-card" wx:if="{{hasUserInfo && sensitivityProgress.total > 0}}">
    <view class="progress-header">
      <text class="progress-title">排敏进度</text>
      <text class="progress-percentage">{{sensitivityProgress.percentage}}%</text>
    </view>
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{sensitivityProgress.percentage}}%"></view>
    </view>
    <view class="progress-info">
      <text class="progress-text">已完成 {{sensitivityProgress.completed}}/{{sensitivityProgress.total}} 种食物</text>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-item" wx:for="{{menuItems}}" wx:key="id" bindtap="onMenuItemTap" data-id="{{item.id}}">
      <view class="menu-icon-wrap">
        <text class="menu-icon">{{item.icon}}</text>
      </view>
      <view class="menu-content">
        <text class="menu-title">{{item.title}}</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section" wx:if="{{hasUserInfo}}">
    <button class="logout-btn" bindtap="logout">退出登录</button>
  </view>

  <!-- 注销账号 -->
  <view class="delete-account-section" wx:if="{{hasUserInfo}}">
    <text class="delete-account-link" bindtap="deleteAccount">注销账号</text>
  </view>

  <!-- 版本 -->
  <view class="version-info">
    <text>版本 1.0.0</text>
  </view>
</view>
