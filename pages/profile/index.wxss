/* pages/profile/index.wxss - MUJI风格优化版 */

.container {
  min-height: 100vh;
  background-color: #FAFAF8;
  padding-bottom: 40px;
}

/* 用户信息卡片 */
.user-card {
  background-color: #FFFFFF;
  padding: 32px 20px 24px;
  margin-bottom: 12px;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar-btn {
  padding: 0;
  background-color: transparent;
  border: none;
  line-height: normal;
}

.avatar-btn::after {
  border: none;
}

.nickname-input {
  width: 100%;
  padding: 0;
  background-color: transparent;
  border: none;
}

.avatar-wrap {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background-color: #F5F3F0;
  margin-right: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar {
  width: 56px;
  height: 56px;
  border-radius: 50%;
}

.avatar-placeholder {
  font-size: 28px;
  color: #B8B2A8;
}

.info {
  flex: 1;
}

.nickname {
  font-size: 20px;
  font-weight: 600;
  color: #8B7355;
  margin-bottom: 6px;
  display: block;
}

.baby-info {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 14px;
  color: #8A847A;
}

.baby-icon {
  font-size: 14px;
}

.baby-name {
  color: #5A554D;
  font-weight: 500;
}

.login-btn {
  background-color: #8B7355;
  color: #FFFFFF;
  font-size: 14px;
  font-weight: 500;
  padding: 10px 24px;
  border-radius: 999px;
  border: none;
  margin-left: auto;
}

.login-btn::after {
  border: none;
}

.login-btn:active {
  background-color: #6B5635;
}

/* 统计卡片 */
.stats-card {
  display: flex;
  background-color: #FFFFFF;
  margin: 0 16px 12px;
  padding: 24px 16px;
  border-radius: 12px;
  box-shadow: 0 2px 6px rgba(45, 42, 38, 0.03);
}

.stats-item {
  flex: 1;
  text-align: center;
  position: relative;
  padding: 8px 0;
  border-radius: 8px;
  transition: background-color 0.2s ease;
}

.stats-item:active {
  background-color: #F5F3F0;
}

.stats-item:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 1px;
  height: 32px;
  background-color: #F0EDE8;
}

.stats-value {
  font-size: 28px;
  font-weight: 600;
  color: #2D2A26;
  display: block;
  margin-bottom: 4px;
  line-height: 1;
}

.stats-label {
  font-size: 12px;
  color: #8A847A;
  font-weight: 400;
}

/* 排敏进度卡片 */
.progress-card {
  background-color: #FFFFFF;
  border-radius: 12px;
  padding: 20px;
  margin: 0 16px 12px;
  box-shadow: 0 2px 6px rgba(45, 42, 38, 0.03);
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.progress-title {
  font-size: 15px;
  font-weight: 600;
  color: #2D2A26;
}

.progress-percentage {
  font-size: 20px;
  font-weight: 600;
  color: #8B7355;
}

.progress-bar {
  width: 100%;
  height: 6px;
  background-color: #F0EDE8;
  border-radius: 3px;
  overflow: hidden;
  margin-bottom: 10px;
}

.progress-fill {
  height: 100%;
  background-color: #8B7355;
  border-radius: 3px;
  transition: width 0.3s ease;
}

.progress-info {
  display: flex;
  justify-content: space-between;
}

.progress-text {
  font-size: 13px;
  color: #8A847A;
}

/* 功能菜单 */
.menu-section {
  background-color: #FFFFFF;
  border-radius: 12px;
  margin: 0 16px 12px;
  padding: 8px 0;
  box-shadow: 0 2px 6px rgba(45, 42, 38, 0.03);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 16px 20px;
  transition: background-color 0.2s;
}

.menu-item:active {
  background-color: #FAFAF8;
}

.menu-icon-wrap {
  width: 32px;
  height: 32px;
  background-color: #F5F3F0;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 14px;
}

.menu-icon {
  font-size: 18px;
}

.menu-content {
  flex: 1;
}

.menu-title {
  font-size: 15px;
  font-weight: 500;
  color: #2D2A26;
}

.menu-desc {
  font-size: 12px;
  color: #8A847A;
  margin-top: 2px;
}

.menu-arrow {
  width: 20px;
  height: 20px;
  color: #B8B2A8;
  font-size: 18px;
}

/* 退出登录按钮 */
.logout-section {
  padding: 0 16px;
  margin-top: 24px;
}

.logout-btn {
  width: 100%;
  height: 48px;
  line-height: 46px;
  background-color: transparent;
  color: #8B7355;
  font-size: 15px;
  font-weight: 500;
  border: 1px solid #E8E4DE;
  border-radius: 24px;
}

.logout-btn::after {
  border: none;
}

.logout-btn:active {
  background-color: #FAFAF8;
  border-color: #8B7355;
}

/* 注销账号 */
.delete-account-section {
  text-align: center;
  padding: 24px 0 32px;
}

.delete-account-link {
  font-size: 13px;
  color: #B8B2A8;
  text-decoration: underline;
  text-decoration-color: #E8E4DE;
}

.delete-account-link:active {
  color: #8B7355;
}

/* 版本信息 */
.version-info {
  text-align: center;
  font-size: 12px;
  color: #B8B2A8;
  margin-top: 16px;
}
