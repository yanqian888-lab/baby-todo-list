/* 任务创建与编辑页面样式 - MUJI风格 */
.container {
  background-color: #FAFAF8;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 30rpx;
  box-sizing: border-box;
}

/* 任务模板选择样式 */
.template-section {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.template-header {
  margin-bottom: 24rpx;
}

.template-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #2D2A26;
}

/* 分组选择器样式 */
.group-selector {
  margin-bottom: 24rpx;
  overflow-x: auto;
  white-space: nowrap;
  padding-bottom: 8rpx;
}

.group-item {
  display: inline-flex;
  align-items: center;
  padding: 16rpx 28rpx;
  margin-right: 20rpx;
  border-radius: 32rpx;
  background: #F5F3F0;
  transition: all 0.3s;
  font-size: 28rpx;
  color: #8A847A;
  border: 2rpx solid transparent;
}

.group-item.active {
  background: #F5F3F0;
  color: #8B7355;
  border-color: #8B7355;
}

.group-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.group-name {
  font-size: 28rpx;
}

/* 年龄段选择器样式 */
.age-range-selector {
  margin-bottom: 24rpx;
  overflow-x: auto;
  white-space: nowrap;
  padding-bottom: 8rpx;
}

.age-range-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 28rpx;
  background: #F8F8F8;
  font-size: 26rpx;
  color: #8A847A;
  transition: all 0.3s;
  border: 2rpx solid transparent;
}

.age-range-item.active {
  background: #F5F3F0;
  color: #8B7355;
  border-color: #8B7355;
}

/* 模板列表样式 */
.template-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: #F8F8F8;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.template-item:last-child {
  margin-bottom: 0;
}

.template-item:active {
  background: #F5F3F0;
  border-color: #E8E4DF;
}

.template-item.active {
  background: #F5F3F0;
  border-color: #8B7355;
}

.template-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background-color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.template-info {
  flex: 1;
}

.template-item-title {
  font-size: 30rpx;
  color: #2D2A26;
  margin-bottom: 8rpx;
  display: block;
  font-weight: 500;
}

.template-item-desc {
  font-size: 24rpx;
  color: #8A847A;
  line-height: 1.4;
}

/* 无模板提示 */
.no-templates {
  text-align: center;
  padding: 48rpx 0;
  color: #B5B0A8;
  font-size: 28rpx;
  background: #F8F8F8;
  border-radius: 16rpx;
}

/* 输入区域样式 */
.input-section {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.input-group {
  margin-bottom: 32rpx;
}

.input-group:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 28rpx;
  color: #2D2A26;
  margin-bottom: 16rpx;
  display: block;
  font-weight: 500;
}

.label.required::after {
  content: ' *';
  color: #E57373;
}

.input {
  width: 100%;
  height: 88rpx;
  border: 1rpx solid #E8E4DF;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  background-color: #F8F8F8;
  box-sizing: border-box;
  color: #2D2A26;
}

.textarea {
  width: 100%;
  min-height: 160rpx;
  border: 1rpx solid #E8E4DF;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  background-color: #F8F8F8;
  box-sizing: border-box;
  line-height: 1.6;
  color: #2D2A26;
}

.input:focus,
.textarea:focus {
  border-color: #8B7355;
  background-color: #FFFFFF;
  outline: none;
}

.input::placeholder,
.textarea::placeholder {
  color: #B5B0A8;
}

/* 选择器样式 */
.picker,
.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  border: 1rpx solid #E8E4DF;
  border-radius: 16rpx;
  padding: 0 24rpx;
  background-color: #F8F8F8;
}

.picker text,
.picker-text {
  font-size: 30rpx;
  color: #2D2A26;
}

.picker-text:empty,
.picker-text:first-child:last-child {
  color: #B5B0A8;
}

.arrow,
.picker-arrow {
  font-size: 24rpx;
  color: #8A847A;
}

/* 分类选择样式 */
.category-options {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.category-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background-color: #F8F8F8;
  border: 1rpx solid transparent;
  transition: all 0.3s;
}

.category-option.active {
  background-color: #F5F3F0;
  border-color: #8B7355;
}

.category-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.category-name {
  font-size: 24rpx;
  color: #2D2A26;
}

.category-option.active .category-name {
  color: #8B7355;
  font-weight: 500;
}

/* 循环选项样式 */
.frequency-options {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.frequency-option {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 40rpx;
  border-radius: 16rpx;
  border: 1rpx solid #E8E4DF;
  background-color: #F8F8F8;
  transition: all 0.3s;
}

.frequency-option.active {
  border-color: #8B7355;
  background-color: #F5F3F0;
}

.frequency-name {
  font-size: 28rpx;
  color: #2D2A26;
}

.frequency-option.active .frequency-name {
  color: #8B7355;
  font-weight: 500;
}

/* 星期选择样式 */
.weekday-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.weekday-option {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 16rpx;
  border: 1rpx solid #E8E4DF;
  background-color: #F8F8F8;
  transition: all 0.3s;
}

.weekday-option.active {
  border-color: #8B7355;
  background-color: #F5F3F0;
}

.weekday-name {
  font-size: 26rpx;
  color: #2D2A26;
}

.weekday-option.active .weekday-name {
  color: #8B7355;
  font-weight: 500;
}

/* 每月日期选择样式 */
.monthday-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.monthday-option {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  border-radius: 16rpx;
  border: 1rpx solid #E8E4DF;
  background-color: #F8F8F8;
  transition: all 0.3s;
}

.monthday-option.active {
  border-color: #8B7355;
  background-color: #F5F3F0;
}

.monthday-name {
  font-size: 26rpx;
  color: #2D2A26;
}

.monthday-option.active .monthday-name {
  color: #8B7355;
  font-weight: 500;
}

/* 底部按钮样式 */
.footer {
  padding: 40rpx 0 60rpx;
  margin-top: auto;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.save-btn {
  width: 100%;
  height: 96rpx;
  background-color: #8B7355;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 96rpx;
  border-radius: 48rpx;
  margin: 0;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(139, 115, 85, 0.2);
}

.save-btn::after {
  border: none;
}

.save-btn:active {
  background-color: #6B563B;
}

.save-btn[disabled] {
  background-color: #B5B0A8;
  opacity: 0.8;
}

.delete-btn {
  width: 100%;
  height: 96rpx;
  background-color: #FFFFFF;
  color: #E57373;
  font-size: 32rpx;
  border: 1rpx solid #E57373;
  line-height: 96rpx;
  border-radius: 48rpx;
  margin: 0;
}

.delete-btn::after {
  border: none;
}

.delete-btn:active {
  background-color: #FFF5F5;
}

/* 加载状态样式 */
.loading {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background-color: rgba(45, 42, 38, 0.8);
  color: #FFFFFF;
  padding: 24rpx 48rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  z-index: 1000;
}
