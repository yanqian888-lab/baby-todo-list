/* 任务创建与编辑页面样式 */
.container {
  background-color: #f8f8f8;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 头部样式 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 44px;
  padding: 0 16px;
  background-color: #fff;
  border-bottom: 1px solid #eee;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.left-btn {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 20px;
  color: #333;
}

.title {
  font-size: 17px;
  font-weight: 600;
  color: #333;
  flex: 1;
  text-align: center;
}

.right-btn {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-btn {
  font-size: 14px;
  color: #FF3B30;
}

/* 任务模板选择样式 */
.template-section {
  margin: 60px 16px 20px;
  background: #fff;
  border-radius: 12px;
  padding: 16px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.template-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 12px;
  cursor: pointer;
}

.template-title {
  font-size: 15px;
  font-weight: 600;
  color: #333;
}

.toggle-arrow {
  font-size: 12px;
  color: #999;
  transition: transform 0.3s;
}

.template-list {
  padding-top: 12px;
  border-top: 1px solid #f0f0f0;
}

/* 分组选择器样式 */
.group-selector {
  margin-bottom: 16px;
  overflow-x: auto;
  white-space: nowrap;
  padding-bottom: 4px;
}

.group-item {
  display: inline-flex;
  align-items: center;
  padding: 8px 16px;
  margin-right: 10px;
  border-radius: 16px;
  background: #f5f5f5;
  transition: all 0.3s;
  font-size: 13px;
}

.group-item.active {
  background: #ff9500;
  color: #fff;
}

.group-icon {
  font-size: 16px;
  margin-right: 6px;
}

.group-name {
  font-size: 13px;
}

/* 年龄段选择器样式 */
.age-range-selector {
  margin-bottom: 16px;
  overflow-x: auto;
  white-space: nowrap;
  padding-bottom: 4px;
}

.age-range-item {
  display: inline-block;
  padding: 6px 14px;
  margin-right: 8px;
  border-radius: 14px;
  background: #f0f0f0;
  font-size: 12px;
  color: #666;
  transition: all 0.3s;
}

.age-range-item.active {
  background: #07c160;
  color: #fff;
}

.template-item {
  display: flex;
  align-items: center;
  padding: 12px 0;
  border-bottom: 1px solid #f7f7f7;
}

.template-item:last-child {
  border-bottom: none;
}

.template-icon {
  width: 40px;
  height: 40px;
  border-radius: 8px;
  background-color: #FFF0F1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  margin-right: 12px;
}

.template-info {
  flex: 1;
}

.template-item-title {
  font-size: 14px;
  color: #333;
  margin-bottom: 4px;
  display: block;
}

.template-item-desc {
  font-size: 12px;
  color: #999;
  line-height: 1.4;
}

/* 无模板提示 */
.no-templates {
  text-align: center;
  padding: 24px 0;
  color: #999;
  font-size: 14px;
}

/* 输入区域样式 */
.input-section {
  background-color: #fff;
  margin: 0 16px;
  border-radius: 12px;
  padding: 16px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.input-group {
  margin-bottom: 20px;
}

.input-group:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 14px;
  color: #666;
  margin-bottom: 10px;
  display: block;
}

.label.required::after {
  content: ' *';
  color: #FF7A85;
}

.input {
  width: 100%;
  height: 44px;
  border: 1px solid #e6e6e6;
  border-radius: 8px;
  padding: 0 16px;
  font-size: 15px;
  background-color: #fff;
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  min-height: 80px;
  border: 1px solid #e6e6e6;
  border-radius: 8px;
  padding: 12px 16px;
  font-size: 15px;
  background-color: #fff;
  box-sizing: border-box;
  line-height: 1.5;
}

.input:focus,
.textarea:focus {
  border-color: #FF7A85;
  outline: none;
}

/* 选择器样式 */
.picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 44px;
  border: 1px solid #e6e6e6;
  border-radius: 8px;
  padding: 0 16px;
  background-color: #fff;
}

.picker text {
  font-size: 15px;
  color: #333;
}

.arrow {
  font-size: 12px;
  color: #999;
}

/* 分类选择样式 */
.category-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.category-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 68px;
  height: 70px;
  border-radius: 8px;
  background-color: #fff;
  border: 1px solid #e6e6e6;
  transition: all 0.3s;
}

.category-option.active {
  background-color: #FFF0F1;
  border-color: #FF7A85;
}

.category-icon {
  font-size: 24px;
  margin-bottom: 8px;
}

.category-name {
  font-size: 12px;
  color: #333;
}

/* 循环选项样式 */
.frequency-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.frequency-option {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10px 20px;
  border-radius: 8px;
  border: 1px solid #e6e6e6;
  background-color: #fff;
  transition: all 0.3s;
}

.frequency-option.active {
  border-color: #FF7A85;
  background-color: #FFF0F1;
}

.frequency-name {
  font-size: 14px;
  color: #333;
}

/* 星期选择样式 */
.weekday-options {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.weekday-option {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  border-radius: 8px;
  border: 1px solid #e6e6e6;
  background-color: #fff;
  transition: all 0.3s;
}

.weekday-option.active {
  border-color: #FF7A85;
  background-color: #FFF0F1;
}

.weekday-name {
  font-size: 14px;
  color: #333;
}

/* 每月日期选择样式 */
.monthday-options {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.monthday-option {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  border-radius: 8px;
  border: 1px solid #e6e6e6;
  background-color: #fff;
  transition: all 0.3s;
}

.monthday-option.active {
  border-color: #FF7A85;
  background-color: #FFF0F1;
}

.monthday-name {
  font-size: 14px;
  color: #333;
}

/* 循环次数滑块样式 */
.cycle-times-slider {
  margin-top: 10px;
  padding: 0 5px;
}

.cycle-times-slider .wx-slider-input {
  color: #FF7A85;
  font-size: 14px;
  font-weight: 500;
}



/* 底部按钮样式 */
.footer {
  padding: 20px 16px 40px;
  background-color: #fff;
  margin-top: auto;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.save-btn {
  width: 100%;
  height: 48px;
  background-color: #FF7A85;
  color: #fff;
  font-size: 17px;
  font-weight: 600;
  line-height: 48px;
  border-radius: 24px;
  margin: 0;
  border: none;
}

.delete-btn {
  width: 100%;
  height: 48px;
  background-color: #fff;
  color: #FF4757;
  font-size: 17px;
  border: 1px solid #FF4757;
  line-height: 48px;
  border-radius: 24px;
  margin: 0;
}

.save-btn:active {
  background-color: #FF6B75;
}

.save-btn[disabled] {
  background-color: #ccc;
  opacity: 0.8;
}

/* 加载状态样式 */
.loading {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background-color: rgba(0, 0, 0, 0.7);
  color: #fff;
  padding: 12px 24px;
  border-radius: 6px;
  font-size: 14px;
  z-index: 1000;
}