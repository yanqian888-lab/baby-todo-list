/* 任务管理页面样式 */
.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #FAFAF8;
}

/* 页面标题 */
.header {
  padding: 24rpx 24rpx 16rpx;
  background-color: transparent;
  margin-bottom: 8rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #2D2A26;
  margin: 0;
  margin-bottom: 16rpx;
  display: block;
}

/* 家庭切换 tabs */
.family-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tab-item {
  padding: 16rpx 32rpx;
  background-color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #6B6560;
  border: 1rpx solid #E8E4DF;
  transition: all 0.2s ease;
}

.tab-item.active {
  background-color: rgba(196, 167, 125, 0.15);
  color: #8B7355;
  border-color: #C4A77D;
  font-weight: 500;
}

.actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.btn-template {
  min-width: 180rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  background-color: #e8f5e9;
  color: #07c160;
  border: 2rpx solid #07c160;
  border-radius: 38rpx;
  padding: 0 24rpx;
}

.btn-create {
  min-width: 180rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  background-color: #FF7A85;
  color: #fff;
  border-radius: 38rpx;
  padding: 0 24rpx;
}

/* 状态标签栏 - 胶囊分段控制器 */
.tab-bar {
  display: flex;
  gap: 8rpx;
  background-color: #F5F3F0;
  border-radius: 999rpx;
  padding: 6rpx;
  margin: 0 24rpx 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #8A847A;
  font-weight: 500;
  border-radius: 999rpx;
  transition: all 0.2s ease;
}

.tab.active {
  color: #8B7355;
  font-weight: 600;
  background-color: #FFFFFF;
  box-shadow: 0 2rpx 6rpx rgba(139, 115, 85, 0.12);
}

/* 分类选择器 - 圆角标签云 */
.category-scroll {
  padding: 0 0 24rpx;
  margin: 0 24rpx;
}

.category-container {
  display: inline-flex;
  gap: 16rpx;
}

.category {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 28rpx;
  background-color: #FFFFFF;
  border: 1rpx solid #E8E4DF;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #8A847A;
  white-space: nowrap;
  transition: all 0.2s ease;
}

.category.active {
  background-color: rgba(196, 167, 125, 0.15);
  border-color: #C4A77D;
  color: #8B7355;
  font-weight: 500;
}

/* 任务列表 */
.task-list {
  flex: 1;
  padding: 0 16rpx 24rpx;
  overflow-y: auto;
}

.task-item {
  background-color: #FFFFFF;
  border-radius: 18rpx;
  padding: 24rpx 24rpx 20rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 4rpx 18rpx rgba(45, 42, 38, 0.06);
}

.task-item.completed .task-title {
  text-decoration: line-through;
  color: #999;
}

.task-item.disabled {
  opacity: 0.65;
}

.task-item.disabled .task-title,
.task-item.disabled .task-desc,
.task-item.disabled .meta-tag,
.task-item.disabled .task-creator,
.task-item.disabled .task-cat,
.task-item.disabled .task-status {
  color: #999;
}

.task-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.task-row-top {
  margin-bottom: 12rpx;
}

.task-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 500;
  color: #2D2A26;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-status {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.task-status.status-completed {
  background-color: rgba(90, 140, 90, 0.1);
  color: #5A8C5A;
}

.task-status.status-pending {
  background-color: rgba(196, 167, 125, 0.1);
  color: #C4A77D;
}

.task-desc {
  font-size: 26rpx;
  color: #6B6560;
  line-height: 1.5;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.task-row-bottom {
  margin-top: 4rpx;
}

.task-meta-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  overflow: hidden;
}

.task-meta-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.meta-tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  white-space: nowrap;
}

.cycle-tag {
  background-color: rgba(139, 115, 85, 0.08);
  color: #8B7355;
}

.type-tag {
  background-color: #F5F3F0;
  color: #8A847A;
}

.date-tag {
  background-color: transparent;
  color: #999;
  padding-left: 0;
}

.task-creator {
  font-size: 22rpx;
  color: #999;
  max-width: 140rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-cat {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  background-color: rgba(196, 167, 125, 0.12);
  color: #8B7355;
  white-space: nowrap;
}



/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-image {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999;
}

/* 加载更多 */
.loading-more {
  display: flex;
  justify-content: center;
  padding: 30rpx 0;
}

.loading-text {
  font-size: 26rpx;
  color: #999;
}

/* 响应式调整 */
@media (max-width: 320px) {
  .container {
    padding-bottom: env(safe-area-inset-bottom);
  }
}