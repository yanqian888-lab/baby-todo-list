<!-- 任务管理页面 -->
<view class="container">
  <!-- 页面标题 + 家庭切换 tabs -->
  <view class="header">
    <text class="title">任务管理</text>
    <view class="family-tabs" wx:if="{{families.length > 0}}">
      <view
        wx:for="{{families}}"
        wx:key="_id"
        class="tab-item {{currentFamilyId === item._id ? 'active' : ''}}"
        bindtap="switchFamilyTab"
        data-tab-id="{{item._id}}"
      >{{item.name || item.displayName}}</view>
    </view>
  </view>

  <!-- 状态标签栏 -->
  <view class="tab-bar">
    <view 
      class="tab {{currentTab === 'all' ? 'active' : ''}}" 
      data-tab="all" 
      bindtap="switchTab"
    >
      全部任务
    </view>
    <view 
      class="tab {{currentTab === 'completed' ? 'active' : ''}}" 
      data-tab="completed" 
      bindtap="switchTab"
    >
      已完成
    </view>
  </view>

  <!-- 分类选择器 -->
  <scroll-view class="category-scroll" scroll-x enable-flex>
    <view class="category-container">
      <view 
        wx:for="{{categories}}" 
        wx:key="id"
        class="category {{currentCategory === item.id ? 'active' : ''}}"
        data-category="{{item.id}}"
        bindtap="switchCategory"
      >
        {{item.name}}
      </view>
    </view>
  </scroll-view>

  <!-- 任务列表 -->
  <scroll-view 
    class="task-list" 
    scroll-y 
    enable-back-to-top 
    bindscrolltolower="onReachBottom"
    refresher-enabled
    bindrefresherrefresh="onPullDownRefresh"
    refresher-triggered="{{refreshing}}"
  >
    <block wx:if="{{tasks.length > 0}}">
      <view 
        wx:for="{{tasks}}" 
        wx:key="_id"
        class="task-item {{item.displayStatus === '已完成' ? 'completed' : ''}} {{currentTab === 'completed' && item.taskType === '单次' ? 'disabled' : ''}}"
        bindtap="goToTaskDetail"
        data-id="{{item._id}}"
        data-type="{{item.taskType}}"
      >
        <!-- 标题 + 状态 -->
        <view class="task-row task-row-top">
          <text class="task-title">{{item.title}}</text>
          <view class="task-status {{item.displayStatus === '已完成' ? 'status-completed' : 'status-pending'}}">
            {{item.displayStatus}}
          </view>
        </view>

        <!-- 描述 -->
        <view wx:if="{{item.description}}" class="task-desc">{{item.description}}</view>

        <!-- 底部信息：周期/日期 + 分类/创建人 -->
        <view class="task-row task-row-bottom">
          <view class="task-meta-left">
            <text wx:if="{{item.taskType && item.taskType !== '单次'}}" class="meta-tag cycle-tag">{{item.taskType}}</text>
            <block wx:if="{{!item.taskType || item.taskType === '单次'}}">
              <text class="meta-tag type-tag">单次</text>
              <text wx:if="{{item.displayDueDate}}" class="meta-tag date-tag">{{item.displayDueDate}}</text>
            </block>
          </view>
          <view class="task-meta-right">
            <text wx:if="{{item.creatorNickName}}" class="task-creator">{{item.creatorNickName}}</text>
            <text wx:if="{{item.categoryName}}" class="task-cat">{{item.categoryName}}</text>
          </view>
        </view>
      </view>
    </block>
    
    <view wx:elif="{{!loading}}" class="empty-state">
      <text class="empty-text">暂无任务</text>
    </view>
    
    <view wx:if="{{loading && tasks.length > 0}}" class="loading-more">
      <text class="loading-text">加载中...</text>
    </view>
  </scroll-view>
</view>