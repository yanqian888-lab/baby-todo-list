/* pages/login/login.wxss - MUJI风格优化版 */

.login-page {
  min-height: 100vh;
  padding: 16px 14px 12px;
  background-color: #F6F3EE;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.login-card {
  width: 100%;
  max-width: 420px;
  background-color: #FFFFFF;
  border-radius: 26px;
  padding: 18px 18px 14px;
  box-shadow: 0 12px 24px rgba(45, 42, 38, 0.08);
  box-sizing: border-box;
}

.logo-wrap {
  width: 76px;
  height: 76px;
  margin: 0 auto 14px;
  border-radius: 22px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo {
  width: 56px;
  height: 56px;
}

.title-block {
  text-align: center;
  margin-bottom: 14px;
}

.main-title {
  font-size: 22px;
  font-weight: 700;
  color: #2D2A26;
  letter-spacing: 0.3px;
  margin-bottom: 4px;
  display: block;
}

.sub-title {
  font-size: 13px;
  color: #7F7A6D;
  line-height: 1.6;
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 18px;
}

.feature-card {
  display: flex;
  align-items: center;
  padding: 12px 14px;
  background-color: #FBF8F3;
  border-radius: 14px;
  border: 1px solid rgba(216, 207, 193, 0.7);
}

.feature-icon {
  width: 30px;
  height: 30px;
  border-radius: 10px;
  background-color: rgba(139, 115, 85, 0.12);
  color: #8B7355;
  font-size: 16px;
  line-height: 30px;
  text-align: center;
  margin-right: 12px;
}

.feature-text {
  font-size: 14px;
  color: #4D473F;
  font-weight: 500;
}

.login-action {
  width: 100%;
}

.login-btn {
  width: 100%;
  height: 46px;
  line-height: 46px;
  background-color: #8B7355;
  color: #FFFFFF;
  font-size: 15px;
  font-weight: 600;
  border-radius: 22px;
  border: none;
  letter-spacing: 1px;
  margin-bottom: 12px;
}

.login-btn::after {
  border: none;
}

.login-btn[disabled] {
  background-color: #DDD3C9;
  opacity: 0.95;
}

.login-btn:not([disabled]):active {
  background-color: #735C40;
}

.agreement {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  margin-bottom: 10px;
}

.checkbox-wrap {
  width: 22px;
  height: 22px;
  margin-top: 1px;
}

.checkbox {
  width: 22px;
  height: 22px;
  border: 2px solid #D4CFC7;
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
}

.checkbox.checked {
  background-color: #8B7355;
  border-color: #8B7355;
}

.agreement-text {
  font-size: 13px;
  color: #7F7A6D;
  line-height: 18px;
  letter-spacing: 0.2px;
  flex: 1;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.link {
  color: #8B7355;
  font-weight: 600;
}

.login-footer {
  margin-top: 10px;
}

.footer-note {
  font-size: 12px;
  color: #A99E90;
  text-align: center;
}

.link:active {
  opacity: 0.75;
}

.login-footer {
  margin-top: 18px;
}

.footer-note {
  font-size: 13px;
  color: #A99E90;
  text-align: center;
}

.copyright {
  font-size: 12px;
  color: #B8B2A8;
  letter-spacing: 1px;
}
