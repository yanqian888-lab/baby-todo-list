<!-- pages/clockin/index.wxml -->
<view class="container">
  <!-- 页面标题 -->
  <view class="header">
    <text class="title">每日打卡</text>
  </view>

  <!-- 用户信息区域 -->
  <view class="user-info-section">
    <view class="avatar">
      <image src="{{userInfo.avatarUrl || '/images/touxiang_moren.png'}}" mode="aspectFill"></image>
    </view>
    <view class="user-details">
      <text class="nickname">{{userInfo.nickName || '用户'}}</text>
      <text class="greeting">今天也要加油哦！</text>
    </view>
  </view>

  <!-- 打卡状态卡片 -->
  <view class="clockin-card">
    <view class="card-header">
      <text class="date">{{currentDate}}</text>
      <view wx:if="{{clockInData.today.checked}}" class="today-checked">
        <text class="check-icon">✓</text>
        <text class="check-text">今日已打卡</text>
      </view>
    </view>

    <!-- 打卡按钮 -->
    <view class="clockin-btn-container">
      <button 
        class="clockin-btn {{clockInData.today.checked ? 'disabled' : ''}}" 
        bindtap="doClockIn"
        disabled="{{clockInData.today.checked}}"
      >
        {{clockInData.today.checked ? '今日已打卡' : '立即打卡'}}
      </button>
      <text wx:if="{{clockInData.today.time}}" class="checkin-time">打卡时间：{{clockInData.today.time}}</text>
    </view>

    <!-- 统计信息 -->
    <view class="statistics">
      <view class="stat-item">
        <text class="stat-value">{{clockInData.streakDays}}</text>
        <text class="stat-label">连续天数</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">{{clockInData.totalDays}}</text>
        <text class="stat-label">累计天数</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">{{monthlyCompletionRate}}%</text>
        <text class="stat-label">本月完成率</text>
      </view>
    </view>

    <!-- 日历查看按钮 -->
    <view class="calendar-btn" bindtap="viewCalendar">
      <text class="calendar-icon">📅</text>
      <text class="calendar-text">查看打卡日历</text>
    </view>
  </view>

  <!-- 最近打卡记录 -->
  <view class="records-section">
    <view class="section-header">
      <text class="section-title">最近打卡记录</text>
    </view>

    <!-- 记录列表 -->
    <view class="records-list">
      <block wx:if="{{records.length > 0}}">
        <view wx:for="{{records}}" wx:key="id" class="record-item">
          <view class="record-date">{{item.date}}</view>
          <view class="record-time">{{item.time}}</view>
          <view class="record-icon">
            <text>✓</text>
          </view>
        </view>
      </block>
      <block wx:else>
        <view class="empty-records">
          <text class="empty-icon">📝</text>
          <text class="empty-text">暂无打卡记录</text>
        </view>
      </block>
    </view>

    <!-- 加载更多 -->
    <view wx:if="{{hasMore}}" class="load-more" bindtap="loadClockInRecords">
      <text>{{loading ? '加载中...' : '点击加载更多'}}</text>
    </view>
  </view>


</view>