/* 打卡统计页面样式 */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 头部样式 */
.header {
  background-color: #fff;
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.total-stats {
  font-size: 28rpx;
  color: #666;
}

/* 月份选择器 */
.month-selector {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #fff;
  padding: 20rpx 30rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.month-btn {
  font-size: 28rpx;
  color: #07c160;
  padding: 10rpx 20rpx;
}

.current-month {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

/* 日历头部 */
.calendar-header {
  display: flex;
  background-color: #fff;
  border-radius: 16rpx 16rpx 0 0;
  padding: 20rpx 0;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.weekday {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  font-weight: bold;
}

/* 日历内容 */
.calendar-content {
  display: flex;
  flex-wrap: wrap;
  background-color: #fff;
  border-radius: 0 0 16rpx 16rpx;
  padding: 20rpx 0 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 20rpx;
}

.calendar-day {
  width: 14.2857%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 15rpx 0;
  position: relative;
  min-height: 100rpx;
}

.day-number {
  font-size: 28rpx;
  color: #333;
}

/* 非当月日期 */
.other-month .day-number {
  color: #ccc;
}

/* 今天 */
.today {
  background-color: #e6f7ff;
  border-radius: 50%;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.today .day-number {
  color: #1890ff;
  font-weight: bold;
}

/* 打卡日期 */
.clock-in .day-number {
  color: #07c160;
  font-weight: bold;
}

.dot {
  position: absolute;
  bottom: 15rpx;
  width: 16rpx;
  height: 16rpx;
  background-color: #07c160;
  border-radius: 50%;
}

/* 日期详情 */
.date-detail {
  background-color: #fff;
  padding: 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.detail-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.detail-time {
  font-size: 28rpx;
  color: #666;
}