<!-- pages/clockin/calendar.wxml -->
<view class="container">
  <!-- 页面标题和返回按钮 -->
  <view class="header">
    <view class="left-btn" bindtap="navigateBack">
      <text class="back-icon">←</text>
    </view>
    <view class="title">打卡日历</view>
    <view class="right-btn" bindtap="goToToday">
      <text class="today-text">今天</text>
    </view>
  </view>

  <!-- 月份选择器 -->
  <view class="month-selector">
    <view class="prev-btn" bindtap="prevMonth">
      <text class="arrow-icon">‹</text>
    </view>
    <view class="current-month">
      <text>{{currentYear}}年{{currentMonth}}月</text>
    </view>
    <view class="next-btn" bindtap="nextMonth">
      <text class="arrow-icon">›</text>
    </view>
  </view>

  <!-- 星期标题 -->
  <view class="weekdays">
    <view class="weekday">日</view>
    <view class="weekday">一</view>
    <view class="weekday">二</view>
    <view class="weekday">三</view>
    <view class="weekday">四</view>
    <view class="weekday">五</view>
    <view class="weekday">六</view>
  </view>

  <!-- 日历网格 -->
  <view class="calendar-grid">
    <block wx:if="{{!loading}}">
      <view 
        wx:for="{{calendarData}}" 
        wx:key="index"
        class="day-item {{item.type === 'prev' || item.type === 'next' ? 'other-month' : ''}} {{item.isToday ? 'today' : ''}} {{isChecked(item.day) ? 'checked' : ''}}"
        data-day="{{item.day}}"
        data-type="{{item.type}}"
        bindtap="onDayTap"
      >
        <text class="day-number">{{item.day}}</text>
        <view wx:if="{{isChecked(item.day)}}" class="check-mark">✓</view>
      </view>
    </block>
    <block wx:else>
      <view class="loading">
        <text>加载中...</text>
      </view>
    </block>
  </view>

  <!-- 图例说明 -->
  <view class="legend">
    <view class="legend-item">
      <view class="legend-dot today-dot"></view>
      <text class="legend-text">今天</text>
    </view>
    <view class="legend-item">
      <view class="legend-dot checked-dot"></view>
      <text class="legend-text">已打卡</text>
    </view>
    <view class="legend-item">
      <view class="legend-dot normal-dot"></view>
      <text class="legend-text">未打卡</text>
    </view>
  </view>

  <!-- 打卡统计 -->
  <view class="statistics">
    <view class="stat-item">
      <text class="stat-label">本月打卡</text>
      <text class="stat-value">{{checkedDays.length}}天</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-label">完成率</text>
      <text class="stat-value">{{calculateCompletionRate()}}%</text>
    </view>
  </view>
</view>