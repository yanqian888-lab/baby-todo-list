/* 测试页面WXSS */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.test-header {
  text-align: center;
  margin-bottom: 30rpx;
  padding: 20rpx;
  background-color: #fff;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.test-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.test-subtitle {
  font-size: 24rpx;
  color: #666;
  display: block;
}

.test-section {
  background-color: #fff;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
  border-bottom: 2rpx solid #eee;
  padding-bottom: 10rpx;
}

.input-group {
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.input-label {
  width: 120rpx;
  font-size: 28rpx;
  color: #666;
  margin-right: 20rpx;
}

.input-field {
  flex: 1;
  height: 60rpx;
  border: 2rpx solid #ddd;
  border-radius: 5rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.info-group {
  margin-bottom: 15rpx;
  display: flex;
  align-items: flex-start;
}

.info-label {
  width: 140rpx;
  font-size: 28rpx;
  color: #666;
  margin-right: 20rpx;
  margin-top: 5rpx;
}

.info-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  word-break: break-all;
}

.button-group {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.test-button {
  height: 80rpx;
  font-size: 28rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  color: #fff;
}

.test-button.primary {
  background-color: #1aad19;
}

.test-button.warning {
  background-color: #ff9500;
}

.test-button.danger {
  background-color: #e64340;
}

.results-container {
  margin-top: 20rpx;
}

.results-scroll {
  height: 400rpx;
  background-color: #f9f9f9;
  border-radius: 8rpx;
  padding: 15rpx;
  border: 2rpx solid #eee;
}

.result-item {
  margin-bottom: 10rpx;
  padding: 10rpx;
  background-color: #fff;
  border-radius: 5rpx;
  border-left: 4rpx solid #1aad19;
}

.result-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
  word-break: break-all;
}