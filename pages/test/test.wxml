<!-- 测试页面WXML -->
<view class="container">
  <view class="test-header">
    <text class="test-title">打卡功能测试工具</text>
    <text class="test-subtitle">用于验证打卡次数更新和显示功能</text>
  </view>

  <view class="test-section">
    <text class="section-title">测试配置</text>
    <view class="input-group">
      <text class="input-label">任务ID:</text>
      <input 
        class="input-field" 
        placeholder="请输入任务ID" 
        value="{{testTaskId}}"
        bindinput="onTaskIdInput"
      />
    </view>
    <view class="input-group">
      <text class="input-label">循环次数:</text>
      <input 
        class="input-field" 
        placeholder="请输入循环次数" 
        value="{{cycleTimes}}"
        type="number"
        bindinput="onCycleTimesInput"
      />
    </view>
  </view>

  <view class="test-section">
    <text class="section-title">任务信息</text>
    <view class="info-group">
      <text class="info-label">当前任务:</text>
      <text class="info-value">{{taskInfo ? JSON.stringify(taskInfo) : '未获取'}}</text>
    </view>
    <view class="info-group">
      <text class="info-label">当前打卡次数:</text>
      <text class="info-value">{{currentCheckins}}</text>
    </view>
    <view class="info-group">
      <text class="info-label">目标打卡次数:</text>
      <text class="info-value">{{cycleTimes}}</text>
    </view>
  </view>

  <view class="test-section">
    <text class="section-title">测试操作</text>
    <view class="button-group">
      <button 
        class="test-button primary" 
        bindtap="getTaskInfo"
      >获取任务信息</button>
      <button 
        class="test-button primary" 
        bindtap="testCheckIn"
      >执行打卡</button>
      <button 
        class="test-button primary" 
        bindtap="testGetCheckIns"
      >获取打卡次数</button>
      <button 
        class="test-button warning" 
        bindtap="resetCheckIns"
      >重置打卡次数</button>
      <button 
        class="test-button danger" 
        bindtap="clearTestResults"
      >清空测试结果</button>
      <button 
        class="test-button success" 
        bindtap="testCloudFunctions"
      >测试云函数</button>
    </view>
  </view>

  <view class="test-section">
    <text class="section-title">测试结果</text>
    <view class="results-container">
      <scroll-view class="results-scroll" scroll-y>
        <view class="result-item" wx:for="{{testResults}}" wx:key="index">
          <text class="result-text">{{item}}</text>
        </view>
      </scroll-view>
    </view>
  </view>
</view>