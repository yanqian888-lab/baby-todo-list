/* pages/family/join.wxss */
.join-container {
  min-height: 100vh;
  background: #FAFAF8;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.loading-section,
.success-section,
.error-section {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-icon,
.success-icon,
.error-icon {
  font-size: 120rpx;
  margin-bottom: 40rpx;
  width: 160rpx;
  height: 160rpx;
  background: #FFFFFF;
  border-radius: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.success-icon {
  background: #8B7355;
  color: #FFFFFF;
  font-size: 80rpx;
}

.error-icon {
  background: #E57373;
  color: #FFFFFF;
  font-size: 80rpx;
}

.loading-text,
.success-title,
.error-title {
  font-size: 40rpx;
  color: #2D2A26;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.success-desc,
.error-desc {
  font-size: 28rpx;
  color: #8A847A;
  text-align: center;
  margin-bottom: 60rpx;
}

.btn-primary {
  width: 400rpx;
  height: 96rpx;
  background: #8B7355;
  color: #FFFFFF;
  font-size: 32rpx;
  border-radius: 48rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(139, 115, 85, 0.2);
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  background: #6B563B;
}
