/* pages/family/index.wxss - 我的家庭页面样式 */

.container {
  min-height: 100vh;
  background-color: #FAFAF8;
  padding-bottom: 40px;
}

/* 区块 */
.section {
  margin-top: 16px;
  padding: 0 16px;
}

.section-title {
  font-size: 14px;
  color: #8A847A;
  margin-bottom: 12px;
  padding-left: 4px;
}

/* 家庭列表 */
.family-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

/* 家庭卡片 */
.family-card {
  background-color: #FFFFFF;
  border-radius: 12px;
  padding: 16px;
  box-shadow: 0 2px 8px rgba(45, 42, 38, 0.04);
}

.family-card.simple {
  padding: 16px;
}

.family-header {
  margin-bottom: 12px;
}

.family-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.family-name {
  font-size: 16px;
  font-weight: 600;
  color: #2D2A26;
}

/* 成员列表 */
.member-list {
  margin-top: 8px;
}

.member-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 0;
  border-bottom: 1px solid #F5F5F5;
}

.member-item:last-child {
  border-bottom: none;
}

.member-label {
  font-size: 14px;
  color: #5A554D;
}

/* 按钮样式 */
.btn-primary {
  background-color: #8B7355;
  color: #FFFFFF;
  font-size: 14px;
  padding: 10px 24px;
  border-radius: 999px;
  text-align: center;
  display: inline-block;
}

.btn-outline {
  background-color: #FFFFFF;
  color: #8B7355;
  font-size: 13px;
  padding: 6px 16px;
  border-radius: 999px;
  border: 1px solid #8B7355;
  text-align: center;
}

.invite-section {
  margin-top: 16px;
  text-align: center;
}

/* 邀请按钮 - MUJI棕色 */
.btn-invite {
  background-color: #8B7355;
  color: #FFFFFF;
  font-size: 14px;
  padding: 12px 48px;
  border-radius: 999px;
  text-align: center;
  display: inline-block;
}

/* 移出按钮 - 黑色边框 */
.btn-remove {
  background-color: #FFFFFF;
  color: #2D2A26;
  font-size: 13px;
  padding: 6px 16px;
  border-radius: 999px;
  border: 1px solid #2D2A26;
  text-align: center;
}

/* 退出按钮 - 黑色边框 */
.btn-exit {
  background-color: #FFFFFF;
  color: #2D2A26;
  font-size: 13px;
  padding: 6px 16px;
  border-radius: 999px;
  border: 1px solid #2D2A26;
  text-align: center;
}

/* 加入其他家庭按钮 - MUJI棕色 */
.btn-join-other {
  background-color: #8B7355;
  color: #FFFFFF;
  font-size: 15px;
  padding: 14px 48px;
  border-radius: 999px;
  text-align: center;
  margin: 20px auto;
  width: fit-content;
  min-width: 160px;
}

.btn-secondary {
  background-color: #FFFFFF;
  color: #8B7355;
  font-size: 14px;
  padding: 12px 24px;
  border-radius: 999px;
  border: 1px solid #8B7355;
  text-align: center;
  margin-top: 12px;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60px 40px;
  text-align: center;
}

.empty-icon {
  font-size: 48px;
  margin-bottom: 16px;
}

.empty-title {
  font-size: 18px;
  font-weight: 600;
  color: #2D2A26;
  margin-bottom: 8px;
}

.empty-desc {
  font-size: 13px;
  color: #8A847A;
  margin-bottom: 24px;
  line-height: 1.5;
}

/* 弹窗样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: none;
}

.modal.show {
  display: block;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  left: 16px;
  right: 16px;
  bottom: 16px;
  background-color: #FFFFFF;
  border-radius: 12px;
  padding: 20px;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

.modal-title {
  font-size: 17px;
  font-weight: 600;
  color: #2D2A26;
}

.modal-close {
  font-size: 24px;
  color: #8A847A;
  padding: 4px;
}

.modal-body {
  margin-bottom: 20px;
}

.modal-footer {
  display: flex;
  justify-content: center;
}

.modal-footer .btn-primary {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 44px;
  padding: 0;
  border-radius: 999px;
  border: none;
  line-height: 1;
}

/* 表单样式 */
.form-item {
  margin-bottom: 16px;
}

.form-label {
  display: block;
  font-size: 14px;
  color: #5A554D;
  margin-bottom: 8px;
}

.form-input {
  width: 100%;
  height: 44px;
  background-color: #F5F5F5;
  border-radius: 8px;
  padding: 0 12px;
  font-size: 14px;
  color: #2D2A26;
  box-sizing: border-box;
}

.form-picker {
  width: 100%;
  height: 44px;
  background-color: #F5F5F5;
  border-radius: 8px;
  padding: 0 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.picker-text {
  font-size: 14px;
  color: #2D2A26;
}

.picker-arrow {
  font-size: 14px;
  color: #8A847A;
}

/* 性别选择 */
.gender-selector {
  display: flex;
  gap: 12px;
}

.gender-option {
  flex: 1;
  height: 44px;
  background-color: #F5F5F5;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  color: #5A554D;
}

.gender-option.active {
  background-color: #8B7355;
  color: #FFFFFF;
}

/* 邀请码 */
.invite-code-section {
  text-align: center;
  padding: 20px 0;
}

.invite-label {
  font-size: 14px;
  color: #8A847A;
  margin-bottom: 12px;
  display: block;
}

.invite-code {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  margin-bottom: 12px;
}

.code-text {
  font-size: 32px;
  font-weight: 600;
  color: #8B7355;
  letter-spacing: 4px;
}

.copy-btn {
  font-size: 14px;
  color: #8B7355;
  padding: 4px 12px;
  border: 1px solid #8B7355;
  border-radius: 12px;
}

.invite-tip {
  font-size: 12px;
  color: #8A847A;
}
