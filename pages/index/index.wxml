<!-- pages/index/index.wxml -->
<view class="container">
  <!-- 页面标题栏 -->
  <view class="page-header">
    <view class="header-left">
      <text class="date-text">{{currentDate}}</text>
      <text class="greeting">{{greeting}}，{{userInfo.nickName}}</text>
    </view>
    <view class="header-right">
    </view>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-card">
    <view class="stats-item">
      <text class="stats-number">{{todayStats.total}}</text>
      <text class="stats-label">今日任务</text>
    </view>
    <view class="stats-divider"></view>
    <view class="stats-item">
      <text class="stats-number">{{todayStats.completed}}</text>
      <text class="stats-label">已完成</text>
    </view>
    <view class="stats-divider"></view>
    <view class="stats-item">
      <text class="stats-number">{{userStats.streakDays}}</text>
      <text class="stats-label">连续打卡</text>
    </view>
    <view class="stats-divider"></view>
    <view class="stats-item">
      <text class="stats-number">{{todayStats.percentage}}%</text>
      <text class="stats-label">完成率</text>
    </view>
  </view>

  <!-- 待打卡区域 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">待打卡</text>
      <text class="section-count">{{todayTasks.length}}</text>
    </view>
    
    <view class="task-list">
      <block wx:for="{{todayTasks}}" wx:key="id">
        <view class="task-item {{item.completed ? 'completed' : ''}}" bindtap="handleTaskTap" data-id="{{item.id}}">
          <view class="task-left">
            <view class="checkbox" bindtap="handleCheckIn" data-id="{{item.id}}">
              <icon wx:if="{{item.completed}}" type="success" size="20" color="#FF7A85"></icon>
            </view>
            <view class="task-info">
              <view class="task-name">{{item.name}}</view>
              <view class="task-subtitle">{{item.subtitle}}</view>
              <!-- 调试信息已移除 -->
              
              <view wx:if="{{item.frequency && item.frequency !== 'none'}}" class="task-frequency">
                <text class="frequency-icon">🔄</text>
                <!-- 针对daily类型 -->
                <text wx:if="{{item.frequency === 'daily'}}" class="frequency-text">每天</text>
                
                <!-- 针对weekly类型 -->
              <text wx:elif="{{item.frequency === 'weekly'}}" class="frequency-text">
                {{item.weekdayText}}
              </text>
              
              <!-- 针对monthly类型 -->
              <text wx:elif="{{item.frequency === 'monthly'}}" class="frequency-text">
                {{item.monthdayText}}
              </text>
              </view>
            </view>
          </view>
          <view class="task-right">
            <view class="task-actions">
              <button class="action-btn edit" bindtap="handleEditTask" data-id="{{item.id}}">编辑</button>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <!-- 已完成区域 -->
  <view class="section" wx:if="{{completedTasks.length > 0}}">
    <view class="section-header">
      <text class="section-title">已完成</text>
    </view>
    
    <view class="completed-list">
      <view wx:for="{{completedTasks}}" wx:key="id" class="completed-item" bindtap="handleTaskTap" data-id="{{item.id}}">
        <view class="completed-left">
          <icon type="success" size="16" color="#999"></icon>
          <view class="completed-info">
            <view class="completed-name">{{item.name}}</view>
            <view class="completed-subtitle">{{item.subtitle}}</view>
            <!-- 调试信息已移除 -->
            
            <view wx:if="{{item.frequency && item.frequency !== 'none'}}" class="task-frequency">
              <text class="frequency-icon">🔄</text>
              <!-- 针对daily类型 -->
              <text wx:if="{{item.frequency === 'daily'}}" class="frequency-text">每天</text>
              
              <!-- 针对weekly类型 -->
              <text wx:elif="{{item.frequency === 'weekly'}}" class="frequency-text">
                {{item.weekdayText}}
              </text>
              
              <!-- 针对monthly类型 -->
              <text wx:elif="{{item.frequency === 'monthly'}}" class="frequency-text">
                {{item.monthdayText}}
              </text>
            </view>
          </view>
        </view>
        <!-- 右侧时间显示已移除 -->
      </view>
    </view>
  </view>

  <!-- 快速添加按钮 -->
  <view class="float-action">
    <view class="add-btn" bindtap="openCreateTask">
      <text class="add-icon">+</text>
    </view>
  </view>
  
  <!-- 测试按钮已移除 -->

  <!-- 事项建议入口 -->
  <view class="suggest-entry" bindtap="openSuggestPage">
    <view class="suggest-icon">💡</view>
    <view class="suggest-text">
      <text class="suggest-title">事项建议</text>
      <text class="suggest-desc">为您推荐适合的育儿任务</text>
    </view>
    <icon type="arrowright" size="16" color="#999"></icon>
  </view>
</view>