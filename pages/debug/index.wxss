/* pages/debug/index.wxss */
.container {
  padding: 20px;
  background-color: #f8f8f8;
  min-height: 100vh;
}

.header {
  margin-bottom: 30px;
  text-align: center;
}

.title {
  font-size: 24px;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10px;
}

.subtitle {
  font-size: 14px;
  color: #666;
}

.section {
  background-color: white;
  border-radius: 8px;
  padding: 20px;
  margin-bottom: 20px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}

.section-title {
  font-size: 18px;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 15px;
}

.btn-danger {
  background-color: #ff4d4f;
  color: white;
  border-radius: 8px;
  padding: 12px 24px;
  font-size: 16px;
  margin-bottom: 10px;
  width: 100%;
}

.btn-danger:active {
  background-color: #cf1322;
}

.btn-primary {
  background-color: #07c160;
  color: white;
  border-radius: 8px;
  padding: 12px 24px;
  font-size: 16px;
  margin-bottom: 10px;
  width: 100%;
}

.btn-primary:active {
  background-color: #06ad56;
}

.btn-secondary {
  background-color: #f0f0f0;
  color: #333;
  border-radius: 8px;
  padding: 12px 24px;
  font-size: 16px;
  margin-bottom: 10px;
  width: 100%;
}

.btn-secondary:active {
  background-color: #e0e0e0;
}

.btn-desc {
  font-size: 12px;
  color: #999;
  display: block;
  margin-bottom: 15px;
  padding: 0 5px;
}

.result {
  background-color: #f0f9eb;
  border: 1px solid #b7eb8f;
  border-radius: 8px;
  padding: 15px;
  margin-top: 20px;
}

.result-title {
  font-weight: bold;
  color: #52c41a;
  display: block;
  margin-bottom: 10px;
}

.result-text {
  font-size: 14px;
  color: #389e0d;
  white-space: pre-wrap;
}

.status-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15px;
  padding: 10px;
  background-color: #fafafa;
  border-radius: 6px;
}

.status-label {
  font-size: 14px;
  color: #666;
}

.status-value {
  font-size: 16px;
  font-weight: bold;
  color: #333;
}
