/* pages/debug/cleanup-today.wxss */
.container {
  padding: 20px;
}

.header {
  margin-bottom: 30px;
}

.title {
  font-size: 24px;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10px;
}

.subtitle {
  font-size: 14px;
  color: #666;
}

.btn-danger {
  background-color: #ff4d4f;
  color: white;
  border-radius: 8px;
  padding: 12px 24px;
  font-size: 16px;
  margin-bottom: 20px;
}

.btn-danger:active {
  background-color: #cf1322;
}

.result {
  background-color: #f5f5f5;
  border-radius: 8px;
  padding: 15px;
  margin-top: 20px;
}

.result-title {
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10px;
}

.result-text {
  font-size: 14px;
  color: #666;
  white-space: pre-wrap;
}
