<!-- pages/debug/cleanup-today.wxml -->
<!-- 清理当天记录页面 -->
<view class="container">
  <view class="header">
    <text class="title">清理当天记录</text>
    <text class="subtitle">删除今天（{{todayDate}}）的所有排敏记录</text>
  </view>

  <button class="btn-danger" bindtap="cleanupTodayRecords">
    删除当天所有记录
  </button>

  <view class="result" wx:if="{{result}}">
    <text class="result-title">清理结果：</text>
    <text class="result-text">{{result}}</text>
  </view>
</view>
