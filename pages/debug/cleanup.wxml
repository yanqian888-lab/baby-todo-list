<!-- pages/debug/cleanup.wxml -->
<!-- 清理重复记录页面 -->
<view class="container">
  <view class="header">
    <text class="title">数据清理工具</text>
    <text class="subtitle">清理重复的排敏记录</text>
  </view>

  <button class="btn-primary" bindtap="cleanupDuplicates">
    清理重复记录
  </button>

  <view class="result" wx:if="{{result}}">
    <text class="result-title">清理结果：</text>
    <text class="result-text">{{result}}</text>
  </view>
</view>
