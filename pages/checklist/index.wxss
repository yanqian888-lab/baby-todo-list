/* pages/checklist/index.wxss - 宝贝清单列表（卡片手风琴展开） */

.container {
  min-height: 100vh;
  background-color: #FAFAF8;
  padding: 16px;
  padding-bottom: calc(90px + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 家庭切换 tabs（与排敏页保持一致） */
.family-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 12px;
}

.tab-item {
  padding: 10px 20px;
  background-color: #FFFFFF;
  border-radius: 999px;
  font-size: 14px;
  color: #6B6560;
  border: 1px solid #E8E4DF;
  transition: all 0.2s ease;
}

.tab-item.active {
  background-color: rgba(196, 167, 125, 0.15);
  color: #8B7355;
  border-color: #C4A77D;
  font-weight: 500;
}

/* 清单卡片 */
.list-card {
  background-color: #FFFFFF;
  border-radius: 16px;
  padding: 20px;
  margin-bottom: 12px;
  box-shadow: 0 2px 6px rgba(45, 42, 38, 0.03);
}

.list-card-header {
  display: flex;
  align-items: center;
  margin: -6px;
  padding: 6px;
  border-radius: 8px;
}

.list-card-header-hover {
  background-color: #F7F5F2;
}

.list-name {
  font-size: 17px;
  font-weight: 600;
  color: #2D2A26;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list-progress {
  font-size: 13px;
  color: #8B7355;
  flex-shrink: 0;
  margin-left: 12px;
}

/* 展开箭头 */
.expand-arrow {
  flex-shrink: 0;
  margin-left: 6px;
  font-size: 18px;
  color: #C8C2B8;
  transform: rotate(90deg);
  transition: transform 0.28s ease;
}

.expand-arrow.expanded {
  transform: rotate(-90deg);
}

/* 收起状态：预览 */
.list-preview {
  margin-top: 12px;
}

.preview-item {
  font-size: 14px;
  color: #8A847A;
  line-height: 1.8;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list-all-done {
  margin-top: 12px;
  font-size: 13px;
  color: #B8B2A8;
}

/* 展开状态：手风琴动画（max-height 过渡） */
.card-body {
  max-height: 0;
  overflow: hidden;
  opacity: 0;
  transition: max-height 0.3s ease, opacity 0.25s ease;
}

.card-body.expanded {
  max-height: 2000px;
  opacity: 1;
}

.card-body-inner {
  padding-top: 12px;
  border-top: 1px solid #F0EDE8;
  margin-top: 12px;
}

/* 条目列表（备忘录勾选式） */
.item-row {
  display: flex;
  align-items: center;
  padding: 12px 0;
  border-bottom: 1px solid #F0EDE8;
}

.item-row:last-child {
  border-bottom: none;
}

/* 圆形勾选框 */
.item-checkbox {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  border: 2px solid #C8C2B8;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12px;
  transition: all 0.15s ease;
}

.item-checkbox.checked {
  background-color: #8B7355;
  border-color: #8B7355;
}

.check-mark {
  color: #FFFFFF;
  font-size: 13px;
  line-height: 1;
}

.item-text {
  flex: 1;
  min-width: 0;
  font-size: 15px;
  color: #2D2A26;
  line-height: 1.5;
  word-break: break-all;
}

.item-text.checked {
  text-decoration: line-through;
  color: #B8B2A8;
}

.item-delete {
  flex-shrink: 0;
  font-size: 20px;
  color: #C8C2B8;
  padding: 4px 8px;
  margin-left: 4px;
}

/* 展开卡片的空清单引导 */
.empty-items {
  text-align: center;
  padding: 20px;
  font-size: 14px;
  color: #B8B2A8;
}

/* 展开卡片底部：条目输入栏 */
.item-input-bar {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 8px;
}

.item-input-field {
  flex: 1;
  min-width: 0;
  height: 40px;
  padding: 0 14px;
  background-color: #F7F7F7;
  border-radius: 999px;
  font-size: 15px;
  color: #2D2A26;
}

.item-input-btn {
  flex-shrink: 0;
  height: 40px;
  line-height: 40px;
  padding: 0 20px;
  background-color: #8B7355;
  color: #FFFFFF;
  font-size: 14px;
  border-radius: 999px;
}

.item-input-btn::after {
  border: none;
}

/* 展开卡片操作区 */
.card-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12px;
  padding-top: 4px;
}

.action-next-round {
  font-size: 14px;
  color: #8B7355;
  padding: 6px 12px;
  border-radius: 999px;
}

.action-delete-list {
  font-size: 14px;
  color: #C05B4D;
  padding: 6px 12px;
  border-radius: 999px;
}

.action-hover {
  background-color: rgba(139, 115, 85, 0.08);
}

/* 空态 */
.empty-lists {
  text-align: center;
  padding: 80px 20px;
}

.empty-icon {
  font-size: 44px;
  margin-bottom: 12px;
}

.empty-text {
  font-size: 14px;
  color: #B8B2A8;
}

/* 右下角新建清单 FAB（与首页添加事项按钮一致） */
.add-btn {
  position: fixed;
  right: 20px;
  bottom: 100px;
  width: 56px;
  height: 56px;
  background-color: #8B7355;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 12px rgba(139, 115, 85, 0.3);
  z-index: 100;
}

.add-btn:active {
  transform: scale(0.95);
  background-color: #6B5635;
}

.add-btn-icon {
  color: #FFFFFF;
  font-size: 28px;
  font-weight: 300;
  line-height: 1;
}

/* ===== 弹窗基础样式（与排敏页保持一致） ===== */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  visibility: hidden;
}

.modal.show {
  visibility: visible;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  left: 16px;
  right: 16px;
  bottom: 16px;
  background-color: #FFFFFF;
  border-radius: 12px;
  padding: 20px;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.modal-title {
  font-size: 17px;
  font-weight: 600;
  color: #2D2A26;
}

.modal-close {
  font-size: 24px;
  color: #8A847A;
  padding: 4px;
}

.modal-body {
  margin-bottom: 20px;
}

.modal-input {
  width: 100%;
  height: 44px;
  padding: 0 12px;
  background-color: #F7F7F7;
  border-radius: 8px;
  font-size: 15px;
  color: #2D2A26;
  box-sizing: border-box;
}

.modal-delete-item {
  margin-top: 16px;
  text-align: center;
  font-size: 14px;
  color: #C05B4D;
  padding: 8px;
}

.modal-footer {
  display: flex;
  gap: 12px;
}

.modal-footer .btn-primary,
.modal-footer .btn-secondary {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 44px;
  padding: 0;
  border-radius: 999px;
  font-size: 15px;
  font-weight: 500;
  text-align: center;
  border: none;
  line-height: 1;
}

.modal-footer .btn-primary {
  background-color: #8B7355;
  color: #FFFFFF;
}

.modal-footer .btn-secondary {
  background-color: #F5F3F0;
  color: #8A847A;
}

.modal-footer .btn-primary::after,
.modal-footer .btn-secondary::after {
  border: none;
}

/* 底部上拉弹窗 */
.modal-bottom .modal-mask {
  opacity: 0;
  transition: opacity 0.28s ease;
}

.modal-bottom.show .modal-mask {
  opacity: 1;
}

.modal-bottom .modal-content {
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 16px 16px 0 0;
  padding: 20px 20px calc(20px + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.28s ease;
}

.modal-bottom.show .modal-content {
  transform: translateY(0);
}

/* 模板选择 chips */
.preset-label {
  font-size: 14px;
  color: #8A847A;
  margin: 16px 0 10px;
}

.preset-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.preset-chip {
  padding: 8px 16px;
  background-color: #F7F7F7;
  border-radius: 999px;
  font-size: 13px;
  color: #6B6560;
  border: 1px solid #E8E4DF;
  transition: all 0.2s ease;
}

.preset-chip.active {
  background-color: rgba(196, 167, 125, 0.15);
  color: #8B7355;
  border-color: #C4A77D;
  font-weight: 500;
}

/* 宝宝信息表单 */
.baby-info-form-section {
  background-color: #FFFFFF;
  border-radius: 12px;
  padding: 32px 24px;
  box-shadow: 0 2px 8px rgba(45, 42, 38, 0.04);
}

.form-header {
  text-align: center;
  margin-bottom: 32px;
}

.form-title {
  font-size: 20px;
  font-weight: 600;
  color: #2D2A26;
  margin-bottom: 8px;
  display: block;
}

.form-subtitle {
  font-size: 14px;
  color: #8A847A;
}

.form-content {
  margin-bottom: 32px;
}

.form-item {
  margin-bottom: 20px;
}

.form-label {
  display: block;
  font-size: 14px;
  font-weight: 500;
  color: #5A554D;
  margin-bottom: 8px;
}

.required {
  color: #C47D7D;
}

.form-input {
  width: 100%;
  height: 48px;
  background-color: #F5F3F0;
  border: 1px solid transparent;
  border-radius: 8px;
  padding: 0 16px;
  font-size: 15px;
  color: #2D2A26;
  box-sizing: border-box;
}

.form-picker {
  width: 100%;
  height: 48px;
  background-color: #F5F3F0;
  border: 1px solid transparent;
  border-radius: 8px;
  padding: 0 16px;
  font-size: 15px;
  color: #8A847A;
  line-height: 48px;
  box-sizing: border-box;
}

.form-picker.has-value {
  color: #2D2A26;
  background-color: #FFFFFF;
  border-color: #E8E4DE;
}

.gender-selector {
  display: flex;
  gap: 12px;
}

.gender-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20px;
  background-color: #F5F3F0;
  border: 2px solid transparent;
  border-radius: 10px;
  transition: all 0.2s;
}

.gender-option.active {
  background-color: #FFFFFF;
  border-color: #8B7355;
}

.gender-icon {
  font-size: 28px;
  margin-bottom: 6px;
}

.gender-text {
  font-size: 14px;
  color: #8A847A;
  font-weight: 500;
}

.gender-option.active .gender-text {
  color: #8B7355;
}

.save-btn {
  width: 100%;
  height: 48px;
  line-height: 48px;
  background-color: #8B7355;
  color: #FFFFFF;
  font-size: 16px;
  font-weight: 500;
  border-radius: 24px;
  border: none;
}

.save-btn::after {
  border: none;
}

.save-btn:active {
  background-color: #6B5635;
}

.join-family-hint {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 16px;
  gap: 4px;
}

.hint-text {
  font-size: 13px;
  color: #8A847A;
}

.hint-link {
  font-size: 13px;
  color: #8B7355;
  font-weight: 500;
}
