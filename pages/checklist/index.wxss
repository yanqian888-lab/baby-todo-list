/* pages/checklist/index.wxss - 宝贝清单列表 */

.container {
  min-height: 100vh;
  background-color: #FAFAF8;
  padding: 16px;
  padding-bottom: calc(90px + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 家庭切换 tabs（与排敏页保持一致） */
.family-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 12px;
}

.tab-item {
  padding: 10px 20px;
  background-color: #FFFFFF;
  border-radius: 999px;
  font-size: 14px;
  color: #6B6560;
  border: 1px solid #E8E4DF;
  transition: all 0.2s ease;
}

.tab-item.active {
  background-color: rgba(196, 167, 125, 0.15);
  color: #8B7355;
  border-color: #C4A77D;
  font-weight: 500;
}

/* 清单卡片 */
.list-card {
  background-color: #FFFFFF;
  border-radius: 16px;
  padding: 20px;
  margin-bottom: 12px;
  box-shadow: 0 2px 6px rgba(45, 42, 38, 0.03);
}

.list-card-hover {
  background-color: #F7F5F2;
}

.list-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.list-name {
  font-size: 17px;
  font-weight: 600;
  color: #2D2A26;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list-progress {
  font-size: 13px;
  color: #8B7355;
  flex-shrink: 0;
  margin-left: 12px;
}

.list-preview {
  margin-top: 12px;
}

.preview-item {
  font-size: 14px;
  color: #8A847A;
  line-height: 1.8;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list-all-done {
  margin-top: 12px;
  font-size: 13px;
  color: #B8B2A8;
}

/* 空态 */
.empty-lists {
  text-align: center;
  padding: 80px 20px;
}

.empty-icon {
  font-size: 44px;
  margin-bottom: 12px;
}

.empty-text {
  font-size: 14px;
  color: #B8B2A8;
}

/* 底部新建按钮 */
.create-btn-wrapper {
  position: fixed;
  left: 16px;
  right: 16px;
  bottom: calc(16px + env(safe-area-inset-bottom));
  z-index: 100;
}

.create-btn {
  height: 48px;
  line-height: 48px;
  background-color: #8B7355;
  color: #FFFFFF;
  font-size: 16px;
  font-weight: 500;
  border-radius: 999px;
  box-shadow: 0 4px 12px rgba(139, 115, 85, 0.3);
}

.create-btn::after {
  border: none;
}

/* ===== 弹窗基础样式（与排敏页保持一致） ===== */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  visibility: hidden;
}

.modal.show {
  visibility: visible;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  left: 16px;
  right: 16px;
  bottom: 16px;
  background-color: #FFFFFF;
  border-radius: 12px;
  padding: 20px;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.modal-title {
  font-size: 17px;
  font-weight: 600;
  color: #2D2A26;
}

.modal-close {
  font-size: 24px;
  color: #8A847A;
  padding: 4px;
}

.modal-body {
  margin-bottom: 20px;
}

.modal-input {
  width: 100%;
  height: 44px;
  padding: 0 12px;
  background-color: #F7F7F7;
  border-radius: 8px;
  font-size: 15px;
  color: #2D2A26;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  gap: 12px;
}

.modal-footer .btn-primary,
.modal-footer .btn-secondary {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 44px;
  padding: 0;
  border-radius: 999px;
  font-size: 15px;
  font-weight: 500;
  text-align: center;
  border: none;
  line-height: 1;
}

.modal-footer .btn-primary {
  background-color: #8B7355;
  color: #FFFFFF;
}

.modal-footer .btn-secondary {
  background-color: #F5F3F0;
  color: #8A847A;
}

.modal-footer .btn-primary::after,
.modal-footer .btn-secondary::after {
  border: none;
}

/* 底部上拉弹窗 */
.modal-bottom .modal-mask {
  opacity: 0;
  transition: opacity 0.28s ease;
}

.modal-bottom.show .modal-mask {
  opacity: 1;
}

.modal-bottom .modal-content {
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 16px 16px 0 0;
  padding: 20px 20px calc(20px + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.28s ease;
}

.modal-bottom.show .modal-content {
  transform: translateY(0);
}

/* 模板选择 chips */
.preset-label {
  font-size: 14px;
  color: #8A847A;
  margin: 16px 0 10px;
}

.preset-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.preset-chip {
  padding: 8px 16px;
  background-color: #F7F7F7;
  border-radius: 999px;
  font-size: 13px;
  color: #6B6560;
  border: 1px solid #E8E4DF;
  transition: all 0.2s ease;
}

.preset-chip.active {
  background-color: rgba(196, 167, 125, 0.15);
  color: #8B7355;
  border-color: #C4A77D;
  font-weight: 500;
}
