<!-- pages/checklist/index.wxml - 宝贝清单列表（卡片手风琴展开） -->
<view class="container">
  <!-- 家庭切换 tabs -->
  <view class="family-tabs" wx:if="{{families.length > 0}}">
    <view
      wx:for="{{families}}"
      wx:key="_id"
      class="tab-item {{currentFamilyId === item._id ? 'active' : ''}}"
      bindtap="switchFamilyTab"
      data-tab-id="{{item._id}}"
    >{{item.name || item.displayName}}</view>
  </view>

  <!-- 清单卡片列表 -->
  <view class="list-section" wx:if="{{lists.length > 0}}">
    <view
      class="list-card {{expandedListId === item._id ? 'expanded' : ''}}"
      wx:for="{{lists}}"
      wx:key="_id"
    >
      <!-- 卡片头部：点击展开/收起 -->
      <view class="list-card-header" data-id="{{item._id}}" bindtap="toggleExpand" hover-class="list-card-header-hover">
        <text class="list-name">{{item.name}}</text>
        <text class="list-progress">{{item.checkedCount}}/{{item.totalCount}} 已完成</text>
        <text class="expand-arrow {{expandedListId === item._id ? 'expanded' : ''}}">›</text>
      </view>

      <!-- 收起状态：仅标题和进度 -->

      <!-- 展开状态：完整备忘录式交互 -->
      <view class="card-body {{expandedListId === item._id ? 'expanded' : ''}}">
        <view class="card-body-inner">
          <!-- 条目列表 -->
          <view class="item-list" wx:if="{{item.items.length > 0}}">
            <view class="item-row" wx:for="{{item.items}}" wx:key="id" wx:for-item="entry">
              <view
                class="item-checkbox {{entry.checked ? 'checked' : ''}}"
                data-list-id="{{item._id}}"
                data-item-id="{{entry.id}}"
                catchtap="toggleItem"
              >
                <text wx:if="{{entry.checked}}" class="check-mark">✓</text>
              </view>
              <view
                class="item-text {{entry.checked ? 'checked' : ''}}"
                data-list-id="{{item._id}}"
                data-item-id="{{entry.id}}"
                bindtap="openEditModal"
              >{{entry.text}}</view>
              <view
                class="item-delete"
                data-list-id="{{item._id}}"
                data-item-id="{{entry.id}}"
                catchtap="deleteItem"
              >×</view>
            </view>
          </view>
          <view class="empty-items" wx:else>点击底部输入框，添加第一个条目吧</view>

          <!-- 条目输入栏 -->
          <view class="item-input-bar">
            <input
              class="item-input-field"
              type="text"
              placeholder="添加条目..."
              value="{{expandedListId === item._id ? newItemText : ''}}"
              bindinput="onNewItemInput"
              confirm-type="done"
              data-list-id="{{item._id}}"
              bindconfirm="addItem"
              maxlength="100"
            />
            <button
              class="item-input-btn"
              disabled="{{adding}}"
              data-list-id="{{item._id}}"
              bindtap="addItem"
            >添加</button>
          </view>

          <!-- 操作区 -->
          <view class="card-actions">
            <text class="action-next-round" data-list-id="{{item._id}}" bindtap="startNextRound" hover-class="action-hover">开启下一轮</text>
            <text wx:if="{{isCreator}}" class="action-delete-list" data-list-id="{{item._id}}" bindtap="deleteList" hover-class="action-hover">删除清单</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空态 -->
  <view class="empty-lists" wx:if="{{!loading && lists.length === 0}}">
    <view class="empty-icon">📝</view>
    <text class="empty-text">还没有清单，点击右下角按钮新建一个吧</text>
  </view>

  <!-- 右下角新建清单 FAB -->
  <view class="add-btn" bindtap="openCreateModal">
    <text class="add-btn-icon">+</text>
  </view>

  <!-- 新建清单弹窗（底部上拉） -->
  <view class="modal modal-bottom {{showCreateModal ? 'show' : ''}}">
    <view class="modal-mask" bindtap="closeCreateModal"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">新建清单</text>
        <text class="modal-close" bindtap="closeCreateModal">×</text>
      </view>
      <view class="modal-body">
        <input
          class="modal-input"
          type="text"
          placeholder="请输入清单名称"
          value="{{newListName}}"
          bindinput="onNameInput"
          maxlength="30"
        />
        <view class="preset-label">选择模板</view>
        <view class="preset-chips">
          <view
            class="preset-chip {{selectedPresetId === item.presetId ? 'active' : ''}}"
            wx:for="{{presetOptions}}"
            wx:key="presetId"
            data-preset-id="{{item.presetId}}"
            bindtap="selectPreset"
          >{{item.name}}</view>
        </view>
      </view>
      <view class="modal-footer">
        <button class="btn-secondary" bindtap="closeCreateModal">取消</button>
        <button class="btn-primary" disabled="{{creating}}" bindtap="submitCreate">{{creating ? '创建中' : '创建'}}</button>
      </view>
    </view>
  </view>

  <!-- 编辑条目弹窗（底部上拉） -->
  <view class="modal modal-bottom {{showEditModal ? 'show' : ''}}">
    <view class="modal-mask" bindtap="closeEditModal"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">编辑条目</text>
        <text class="modal-close" bindtap="closeEditModal">×</text>
      </view>
      <view class="modal-body">
        <input
          class="modal-input"
          type="text"
          placeholder="请输入条目内容"
          value="{{editingText}}"
          bindinput="onEditInput"
          maxlength="100"
          focus="{{showEditModal}}"
        />
        <view class="modal-delete-item" bindtap="deleteItem">删除此条目</view>
      </view>
      <view class="modal-footer">
        <button class="btn-secondary" bindtap="closeEditModal">取消</button>
        <button class="btn-primary" disabled="{{saving}}" bindtap="saveEditItem">{{saving ? '保存中' : '保存'}}</button>
      </view>
    </view>
  </view>
</view>
