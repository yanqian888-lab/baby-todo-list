<!-- pages/checklist/detail.wxml - 清单详情 -->
<view class="container">
  <!-- 顶部操作栏 -->
  <view class="top-bar" wx:if="{{items.length > 0}}">
    <text class="top-progress">{{items.length}} 个条目</text>
    <text class="next-round-btn" bindtap="startNextRound" hover-class="next-round-hover">开启下一轮</text>
  </view>

  <!-- 条目列表 -->
  <view class="item-list" wx:if="{{items.length > 0}}">
    <view class="item-row" wx:for="{{items}}" wx:key="id">
      <view
        class="item-checkbox {{item.checked ? 'checked' : ''}}"
        data-id="{{item.id}}"
        catchtap="toggleItem"
      >
        <text wx:if="{{item.checked}}" class="check-mark">✓</text>
      </view>
      <view
        class="item-text {{item.checked ? 'checked' : ''}}"
        data-id="{{item.id}}"
        bindtap="openEditModal"
      >{{item.text}}</view>
      <view class="item-delete" data-id="{{item.id}}" catchtap="deleteItem">×</view>
    </view>
  </view>

  <!-- 空清单引导 -->
  <view class="empty-items" wx:if="{{!loading && items.length === 0}}">
    <view class="empty-icon">📝</view>
    <text class="empty-text">点击底部输入框，添加第一个条目吧</text>
  </view>

  <!-- 删除清单入口（仅家庭创建者可见） -->
  <view class="delete-list-entry" wx:if="{{isCreator && !loading}}" bindtap="deleteList">
    <text class="delete-list-text">删除清单</text>
  </view>

  <!-- 底部固定输入栏 -->
  <view class="input-bar">
    <input
      class="input-bar-field"
      type="text"
      placeholder="添加条目..."
      value="{{newItemText}}"
      bindinput="onNewItemInput"
      confirm-type="done"
      bindconfirm="addItem"
      maxlength="100"
    />
    <button class="input-bar-btn" disabled="{{adding}}" bindtap="addItem">添加</button>
  </view>

  <!-- 编辑条目弹窗（底部上拉） -->
  <view class="modal modal-bottom {{showEditModal ? 'show' : ''}}">
    <view class="modal-mask" bindtap="closeEditModal"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">编辑条目</text>
        <text class="modal-close" bindtap="closeEditModal">×</text>
      </view>
      <view class="modal-body">
        <input
          class="modal-input"
          type="text"
          placeholder="请输入条目内容"
          value="{{editingText}}"
          bindinput="onEditInput"
          maxlength="100"
          focus="{{showEditModal}}"
        />
        <view class="modal-delete-item" bindtap="deleteItem">删除此条目</view>
      </view>
      <view class="modal-footer">
        <button class="btn-secondary" bindtap="closeEditModal">取消</button>
        <button class="btn-primary" disabled="{{saving}}" bindtap="saveEditItem">{{saving ? '保存中' : '保存'}}</button>
      </view>
    </view>
  </view>
</view>
