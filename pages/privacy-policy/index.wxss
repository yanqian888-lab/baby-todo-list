.page-container {
  min-height: 100vh;
  padding: 22px 18px 18px;
  background-color: #F6F3EE;
  box-sizing: border-box;
}

.page-container > view,
.page-container scroll-view {
  opacity: 0;
  transition: opacity 0.15s ease-in-out;
}

.page-container.fade-in > view,
.page-container.fade-in scroll-view {
  opacity: 1;
}

.page-header {
  padding: 18px 16px;
  background-color: #FFFFFF;
  border-radius: 22px;
  margin-bottom: 12px;
}

.page-title {
  font-size: 20px;
  font-weight: 700;
  color: #2D2A26;
}

.page-content {
  height: calc(100vh - 120px);
  background-color: #FFFFFF;
  border-radius: 22px;
  padding: 16px;
  box-sizing: border-box;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.section {
  margin-bottom: 18px;
}

.section-title {
  display: block;
  font-size: 15px;
  font-weight: 600;
  color: #2D2A26;
  margin-bottom: 16px;
}

.section-text {
  display: block;
}

.section-text {
  font-size: 14px;
  color: #6F6B60;
  line-height: 1.8;
}
