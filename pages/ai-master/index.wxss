/* pages/ai-master/index.wxss - MUJI风格聊天页 */

page {
  background-color: #FAFAF8;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #FAFAF8;
  overflow: hidden;
}

/* 头部 Agent 信息 */
.agent-header {
  display: flex;
  align-items: center;
  padding: 16px 20px;
  background-color: #FFFFFF;
  border-bottom: 1px solid #F0EDE8;
}

.agent-avatar {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  margin-right: 12px;
  background-color: #F5F3F0;
}

.agent-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.agent-name {
  font-size: 16px;
  font-weight: 600;
  color: #2D2A26;
  margin-bottom: 2px;
}

.agent-intro {
  font-size: 13px;
  color: #8A847A;
}

/* 消息列表 */
.message-list {
  flex: 1;
  height: 0;
  padding: 16px;
  box-sizing: border-box;
  overflow: hidden;
}

.message-list-footer {
  height: 20px;
}

/* 欢迎消息 */
.welcome-message {
  display: flex;
  justify-content: center;
  margin-bottom: 24px;
}

.welcome-bubble {
  background-color: #FFFFFF;
  border-radius: 16px;
  padding: 20px 24px;
  max-width: 80%;
  box-shadow: 0 2px 8px rgba(45, 42, 38, 0.04);
  text-align: center;
}

.welcome-text {
  font-size: 14px;
  color: #5A554D;
  line-height: 1.6;
}

/* 消息项 */
.message-item {
  display: flex;
  margin-bottom: 20px;
  align-items: flex-start;
}

.message-item.bot {
  flex-direction: row;
}

.message-item.user {
  flex-direction: row-reverse;
}

.message-avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background-color: #F5F3F0;
  flex-shrink: 0;
}

.message-item.bot .message-avatar {
  margin-right: 10px;
}

.message-item.user .message-avatar {
  margin-left: 10px;
}

.message-content {
  max-width: 70%;
  display: flex;
  flex-direction: column;
}

.message-bubble {
  padding: 12px 16px;
  border-radius: 16px;
  font-size: 15px;
  line-height: 1.5;
  word-break: break-word;
}

.message-item.bot .message-bubble {
  background-color: #FFFFFF;
  color: #2D2A26;
  border-top-left-radius: 4px;
  box-shadow: 0 1px 4px rgba(45, 42, 38, 0.04);
}

.message-item.user .message-bubble {
  background-color: #8B7355;
  color: #FFFFFF;
  border-top-right-radius: 4px;
}

.image-bubble {
  padding: 8px;
  overflow: hidden;
}

.message-image {
  max-width: 200px;
  max-height: 200px;
  border-radius: 10px;
  display: block;
}

.message-text {
  display: block;
}

/* 打字指示器 */
.typing-indicator {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 16px;
  background-color: #FFFFFF;
  border-radius: 16px;
  border-top-left-radius: 4px;
  width: fit-content;
  margin-top: 4px;
  box-shadow: 0 1px 4px rgba(45, 42, 38, 0.04);
}

.dot {
  width: 6px;
  height: 6px;
  background-color: #B8B2A8;
  border-radius: 50%;
  animation: typingBounce 1.4s infinite ease-in-out both;
}

.dot:nth-child(1) {
  animation-delay: -0.32s;
}

.dot:nth-child(2) {
  animation-delay: -0.16s;
}

@keyframes typingBounce {
  0%, 80%, 100% {
    transform: scale(0.6);
    opacity: 0.5;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}

/* 快捷问题 */
.quick-questions {
  padding: 0 16px 12px;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.quick-question-item {
  background-color: #FFFFFF;
  border: 1px solid #E8E4DE;
  border-radius: 16px;
  padding: 8px 14px;
}

.quick-question-item:active {
  background-color: #F5F3F0;
  border-color: #8B7355;
}

.quick-question-text {
  font-size: 13px;
  color: #5A554D;
}

/* 输入区域 */
.input-area {
  flex-shrink: 0;
  background-color: #FFFFFF;
  border-top: 1px solid #F0EDE8;
  padding: 4px 8px;
  padding-bottom: calc(0px + env(safe-area-inset-bottom));
}

.toolbar-btn {
  width: 36px;
  height: 36px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #F5F3F0;
  border-radius: 50%;
}

.toolbar-btn:active {
  background-color: #E8E4DE;
}

.toolbar-icon {
  font-size: 18px;
}

.input-row {
  display: flex;
  align-items: flex-end;
  gap: 6px;
}

.message-input {
  flex: 1;
  min-height: 36px;
  max-height: 120px;
  background-color: #F5F3F0;
  border-radius: 18px;
  padding: 6px 10px;
  font-size: 15px;
  color: #2D2A26;
  line-height: 1.4;
  box-sizing: border-box;
}

.input-placeholder {
  color: #B8B2A8;
}

.send-btn {
  width: 64px;
  height: 44px;
  line-height: 44px;
  background-color: #E8E4DE;
  color: #FFFFFF;
  font-size: 15px;
  font-weight: 500;
  border-radius: 20px;
  border: none;
  padding: 0;
  text-align: center;
  transition: all 0.2s;
}

.send-btn::after {
  border: none;
}

.send-btn.active {
  background-color: #8B7355;
}

.send-btn.active:active {
  background-color: #6B5635;
}

.send-icon {
  display: block;
}
